# ============================================================================
# ZSH ALIASES - Optimized for Data Engineering/MLOps
# ============================================================================

# ============================================================================
# EZA - Basic Listing
# ============================================================================
if command -v eza >/dev/null 2>&1; then
  alias ls='eza'
  alias l='eza'
  # Dotfiles only
  alias l.='eza -d .* --color=auto'

  # ============================================================================
  # EZA - Standard Views
  # ============================================================================
  alias ll='eza -l --icons --git --group-directories-first'
  alias la='eza -la --icons --git --group-directories-first'
  alias lh='eza -la --icons --header --group-directories-first'

  # ============================================================================
  # EZA - Filtered Views (Developer-focused)
  # ============================================================================
  alias lsd='eza -D --icons'
  alias lsf='eza -f --icons'
  alias lgit='eza -l --icons --git --git-ignore'
  alias lr='eza -lR --icons'

  # ============================================================================
  # EZA - Sorted Views
  # ============================================================================
  alias lz='eza -l --icons --sort=size'
  alias lm='eza -l --icons --sort=modified'
  alias lx='eza -lh --icons --sort=extension'

  # ============================================================================
  # EZA - Tree Views (Hybrid Approach)
  # ============================================================================
  # Eza tree variants with 'et' prefix
  alias et='eza -T --icons --level=2'
  alias et1='eza -T --icons --level=1'
  alias et3='eza -T --icons --level=3'
  alias eta='eza -T -a --icons --level=2 --ignore-glob=".git"'

  # Developer-focused tree (ignore build artifacts, deps, etc.)
  alias treez='eza -T -L 3 --icons --ignore-glob=".*|*.egg-info|*.log|*.lock" --ignore-glob="node_modules|__pycache__|venv|dist|build|cmake-build-*|_build|target|coverage"'

  # ============================================================================
  # EZA - Interactive & Utility
  # ============================================================================
  alias lf='eza -la --icons | fzf'
  alias lgrep='eza -la --icons | grep'
fi

# ============================================================================
# TREE - Keep standalone tree with colors (for deep/fast operations)
# ============================================================================
if command -v tree >/dev/null 2>&1; then
  alias tree='tree -C'
fi

# ============================================================================
# ZOXIDE (Better cd)
# ============================================================================
if command -v zoxide >/dev/null 2>&1; then
  alias cd="z"
  # Interactive directory picker; zz jumps back to the previous directory
  alias cdi="zi"
  alias zz="z -"
fi

# ============================================================================
# NAVIGATION
# ============================================================================
alias ..='builtin cd ..'
alias ...='builtin cd ../..'
alias ....='builtin cd ../../..'

# ============================================================================
# TRASH (trash-cli — FreeDesktop unified trash)
# ============================================================================
if command -v trash-put >/dev/null 2>&1; then
  alias tp='trash-put'
  alias tl='trash-list'
  alias te='trash-empty'
  alias trestore='trash-restore'
fi

# ============================================================================
# SAFETY & UTILITIES
# ============================================================================
alias grep='grep --color=auto'
alias df='df -h'
alias du='du -h'
alias free='free -h'

# ============================================================================
# LAZYGIT
# ============================================================================
# lg is a function (zsh/functions/shpool.zsh) -- per-repo shpool session so
# closing the window never kills lazygit mid-operation, and running `lg`
# again from the same repo reattaches instead of a plain alias silently
# reusing whatever directory the session was first created in.

# ============================================================================
# SHPOOL
# ============================================================================
command -v shpool >/dev/null 2>&1 && alias sessions='shpool list'

# ============================================================================
# VIM
# ============================================================================
alias vi="vim"

# ============================================================================
# UTILITY COMMANDS
# ============================================================================
# Print the last command
alias plc='fc -ln -1'
alias zsh-update='~/.config/zsh/update-plugins.sh'
# sysup is a function (zsh/functions/sysup.zsh) — full system + tooling update
# sysclean is a function (zsh/functions/sysclean.zsh) — smart system & cache cleanup

# ============================================================================
# NCDU
# ============================================================================
command -v ncdu >/dev/null 2>&1 && alias ncdu='ncdu -x'

# ============================================================================
# GTK APPS
# ============================================================================
command -v pavucontrol >/dev/null 2>&1 && alias pavucontrol='GTK_THEME=Adwaita:dark GTK_A11Y=none pavucontrol'

# ============================================================================
# File opening
# ============================================================================
# open-detached: xdg-open in its own session, output to the journal.
alias o="open-detached"
(($+functions[compdef])) && compdef _files o

# ============================================================================
# EDITOR FALLBACKS
# ============================================================================
alias nano='vim'

# ============================================================================
# YT-DLP
# ============================================================================
# Lean audio download: bestaudio only (no fetch-then-discard), no subtitles,
# into a separate folder. Everything else is inherited from
# ~/.config/yt-dlp/config (PO token, --embed-thumbnail/--embed-metadata ->
# tagged audio with cover art). Mirrors the GUI's Audio mode.
command -v yt-dlp >/dev/null 2>&1 \
  && alias yta='yt-dlp -f "bestaudio/best" -x -P ~/Downloads/Audio --no-write-subs --no-embed-subs'
