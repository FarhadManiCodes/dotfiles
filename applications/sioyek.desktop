[Desktop Entry]
Name=Sioyek
Comment=PDF and EPUB viewer for reading research papers and technical books
Keywords=pdf;epub;viewer;reader;research;
TryExec=sioyek
Exec=sioyek %f
StartupNotify=true
Terminal=false
Type=Application
Icon=sioyek-icon-linux
Categories=Office;Viewer;
MimeType=application/pdf;application/epub+zip;
StartupWMClass=sioyek
