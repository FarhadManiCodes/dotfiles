#!/bin/sh
# /usr/lib/systemd/system-sleep/unblock-fuse
#
# A task waiting on an unanswered FUSE request is uninterruptible: the freezer
# cannot freeze it and SIGKILL does not reach it, so the suspend aborts with
# EBUSY. With the lid shut logind then retries indefinitely -- on 2026-09-02 one
# wedged `du` on an rclone mount produced 916 suspend attempts, 456 hard aborts
# and 1831 wifi disconnects between 22:12 and 11:06.
#
# Verified on 7.2.2 (2026-09-03): writing 1 to a connection's `abort` completes
# its pending requests and releases a waiter that SIGKILL could not.
#
# Aborting tears the mount down, so the rclone units are restarted afterwards --
# but only when `pre` actually acted. A normal suspend touches nothing.
#
# The restart cannot happen in `post` itself. Verified 2026-09-03: post hooks run
# while user.slice is still frozen (user@1000 = frozen-by-parent), so a call into
# the user manager dies instantly with "Transport endpoint is not connected" --
# it fails fast rather than blocking, so simply backgrounding it is not enough.
# Nor can we background and wait: systemd-suspend.service is Type=oneshot with
# KillMode=control-group, so any child still in that cgroup is SIGTERMed the
# moment the hook returns. So `post` hands off to a transient unit via
# systemd-run, which lives outside that cgroup, and that unit waits for the thaw.
#
# Every outcome is logged. This exact call failing silently is why the sibling
# restart-swayidle hook went unnoticed as a no-op.

MARKER=/run/unblock-fuse.aborted

# PIDs sitting uninterruptibly inside a FUSE request.
wedged_pids() {
    # State comes from /proc/PID/status, not /proc/PID/stat: the latter is
    # `pid (comm) state ...` and comm may contain spaces, so a positional
    # field lands inside the process name instead of on the state.
    for status in /proc/[0-9]*/status; do
        pid=${status%/status}; pid=${pid#/proc/}
        [ "$(awk '/^State:/{print $2; exit}' "$status" 2>/dev/null)" = "D" ] || continue
        case "$(cat "/proc/$pid/wchan" 2>/dev/null)" in
            request_wait_answer|*fuse*) printf '%s ' "$pid" ;;
        esac
    done
}

case "$1" in
pre)
    rm -f "$MARKER"
    first=$(wedged_pids)
    [ -n "$first" ] || exit 0

    # Sample twice: a slow-but-working mount can show D briefly. Only treat a
    # PID still wedged 2s later as genuinely stuck, so we never kill a healthy
    # mount that was merely mid-request.
    sleep 2
    second=$(wedged_pids)
    stuck=""
    for p in $first; do
        case " $second " in *" $p "*) stuck="$stuck $p" ;; esac
    done
    [ -n "$stuck" ] || exit 0

    # Abort only connections with requests actually outstanding.
    aborted=""
    for conn in /sys/fs/fuse/connections/*; do
        [ -f "$conn/waiting" ] || continue
        w=$(cat "$conn/waiting" 2>/dev/null)
        [ "${w:-0}" -gt 0 ] 2>/dev/null || continue
        if echo 1 > "$conn/abort" 2>/dev/null; then
            aborted="$aborted ${conn##*/}"
        fi
    done
    [ -n "$aborted" ] || exit 0

    : > "$MARKER"
    logger -t unblock-fuse "wedged in FUSE:$stuck -- aborted connections:$aborted"
    ;;

post)
    [ -e "$MARKER" ] || exit 0
    rm -f "$MARKER"
    out=$(systemd-run --no-block --collect --unit=unblock-fuse-remount \
            --description="Remount rclone after unblock-fuse aborted a connection" \
            "$0" remount 2>&1) \
        && logger -t unblock-fuse "queued remount via systemd-run" \
        || logger -t unblock-fuse "FAILED to queue remount: $out"
    ;;

remount)
    # Runs as a transient unit, so it outlives the sleep hook. Wait for the thaw
    # before touching the user manager; without this the restart fails instantly.
    i=0
    while [ "$(systemctl show user.slice -p FreezerState --value 2>/dev/null)" != "running" ]; do
        i=$((i + 1))
        if [ "$i" -gt 60 ]; then
            logger -t unblock-fuse "user.slice still frozen after ${i}s -- rclone NOT remounted"
            exit 1
        fi
        sleep 1
    done
    [ "$i" -gt 0 ] && logger -t unblock-fuse "user.slice thawed after ${i}s"

    for uid in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $1}'); do
        [ "$uid" -ge 1000 ] 2>/dev/null || continue
        user=$(id -nu "$uid" 2>/dev/null) || continue
        # --plain: without it systemctl prefixes a failed unit with a bullet, so
        # $1 would be the bullet and not the unit name -- and this runs exactly
        # when those units are most likely to be failed.
        for u in $(systemctl --user --machine="${user}@.host" list-units --all \
                       --plain --no-legend --no-pager 'rclone@*.service' 2>/dev/null \
                   | awk '{print $1}'); do
            out=$(systemctl --user --machine="${user}@.host" restart "$u" 2>&1)
            if [ $? -eq 0 ]; then
                logger -t unblock-fuse "restarted $u for $user"
            else
                logger -t unblock-fuse "FAILED to restart $u for $user: $out"
            fi
        done
    done
    ;;
esac
exit 0
