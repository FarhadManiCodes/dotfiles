# Samsung (04e8) tablet, plugged in every month or two to move files. The MTP
# software is installed on demand rather than kept, so this rule has to be
# correct before that software exists.
#
# uaccess hands the device to whoever is logged in at this laptop and revokes it
# at logout. It replaces MODE="0666", which handed it to every process on the
# machine, and a GROUP="users" that did nothing -- this user is not in that group.
SUBSYSTEM=="usb", ATTR{idVendor}=="04e8", MODE="0660", TAG+="uaccess"
