[Unit]
Description=Rclone mount for %I

# There is deliberately NO network-online.target ordering here, and adding it
# back would be a no-op rather than an improvement. That target does not exist
# in the user manager at all -- `systemctl --user show network-online.target`
# reports LoadState=not-found -- and a user unit cannot order itself against a
# system unit. So the `After=`/`Wants=` pair this file used to carry did nothing
# on any machine, not merely on this one where systemd-networkd-wait-online is
# masked. Nothing warns about it either: systemd-analyze verify reports a
# missing Requires= but a missing Wants= is legal and silent by design, so no
# check can catch this -- the only remedy is not writing the line.
#
# What actually survives a network-less start is Restart= plus the StartLimit*
# window below. Measured on the 2026-09-04 13:34 boot, where wifi took 103s:
# the first attempt failed on DNS, and the retry had the mount serving at
# 13:36:30.8 -- 4.6s after the network became usable at 13:36:26, and it could
# not have been earlier no matter what any ordering claimed.

# Do not let a cloud mount hold up the session. systemd orders a target after
# everything it Wants=, so `WantedBy=graphical-session.target` below silently
# added `Before=graphical-session.target` here -- and graphical-session.target is
# what mako, swayidle and the portals wait for. Measured on the 2026-09-04
# 13:34 boot: wifi took 103s, this unit spent 84s of it failing on
# `lookup www.googleapis.com: Temporary failure in name resolution`, and the
# session's own services did not start until it gave up. **swayidle was among
# them, so there was no idle lock for the first 96 seconds of that session.**
#
# DefaultDependencies=no drops that implicit ordering. It also drops the
# implicit shutdown ordering, which is not optional here -- without it the
# ExecStop lazy unmount is not guaranteed to run before the manager goes down --
# so the next two lines put exactly that part back.
DefaultDependencies=no
Conflicts=shutdown.target
Before=shutdown.target

# Retries used to be every 10s forever: with RestartSec=10 the default
# StartLimitIntervalSec=10s window never elapsed, so the burst never tripped and
# a permanently broken mount (e.g. revoked OAuth) retried ~8,640 times a day
# without ever reaching `failed` — invisible to `systemctl --user --failed`.
# Widened so the burst can trip; combined with the backoff below the unit tries
# for ~25 minutes before giving up, which is far longer than any start observed
# here (9/9 mounts in 30 days came up within 10s).
StartLimitIntervalSec=3600
StartLimitBurst=10

OnFailure=notify-failure@%n.service

[Service]
Type=notify
Environment=RCLONE_CONFIG=%h/.config/rclone/rclone.conf

# Yield CPU to interactive work during the post-login mount/cache-warm burst.
# With --vfs-cache-mode full each mount pins a core for ~10-15s reconciling its
# cache, starving starship's git call so it blows command_timeout (2000ms). At
# CPUWeight=25 the foreground shell (weight 100) wins ~4:1 when contended. IO is
# left at the normal class so opening cloud files stays responsive.
Nice=15
CPUWeight=25

# Auto-create the specific mount folder
ExecStartPre=/usr/bin/mkdir -p %h/Cloud/%i

# The Mount Command
ExecStart=/usr/bin/rclone mount %i: %h/Cloud/%i \
    --vfs-cache-mode full \
    --vfs-cache-max-size 5G \
    --vfs-cache-max-age 168h \
    --vfs-cache-poll-interval 1m \
    --vfs-write-back 5s \
    --dir-cache-time 5m \
    --buffer-size 32M \
    --cache-dir=%h/.cache/rclone/%i \
    --timeout 1h \
    --contimeout 60s \
    --retries 3 \
    --low-level-retries 10 \
    --no-modtime \
    --no-checksum \
    --log-level NOTICE \
    --log-file %h/.cache/rclone/logs/rclone-%i.log

# Lazy Unmount (Detaches immediately, prevents shutdown hangs)
ExecStop=/bin/fusermount3 -uz %h/Cloud/%i

# Exponential backoff (systemd >= 254): 10s, 20s, 39s, 77s, 152s, then 300s.
# Keeps the old self-healing behaviour through a slow network start while
# capping a permanent failure at ~10 attempts instead of thousands a day.
Restart=on-failure
RestartSec=10
RestartSteps=5
RestartMaxDelaySec=300

[Install]
WantedBy=graphical-session.target
