[Unit]
Description=Microphone active notifications
After=graphical-session.target
OnFailure=notify-failure@%n.service

[Service]
# Built from ~/projects/mic-notify (make install): a freestanding C program
# that watches /dev/snd capture devices with inotify. 1 process, ~20 KB.
ExecStart=%h/.local/bin/mic-notify
Restart=on-failure
RestartSec=5

# Sandboxing, same profile as power-notify.service, plus /dev/snd (below).
# It reads /dev/snd (directory and inotify watches) and /proc/asound, and
# writes nothing.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077

# PrivateDevices=yes gives a /dev without /dev/snd, so the real one is bound in,
# read-only. inotify watches the device node itself, so opens by PipeWire outside
# the sandbox still arrive. The bound nodes CAN be opened (a user manager does
# not enforce the device policy; verified 2026-09-29), but the program never
# opens one, and could reach PipeWire's socket anyway, as the pactl version did.
PrivateDevices=yes
BindReadOnlyPaths=/dev/snd

# AF_UNIX for notify-send's session bus; the program itself opens no socket.
RestrictAddressFamilies=AF_UNIX

# @system-service must permit fork/execve: notify-send runs on each change.
SystemCallFilter=@system-service

# Deliberately NOT set: CapabilityBoundingSet=. A user service already runs with
# no effective capabilities and NoNewPrivileges blocks acquiring any, so it would
# be redundant -- same reasoning as DropCapability in containers/pg.container.

[Install]
WantedBy=graphical-session.target
