[Unit]
Description=Microphone active notifications
After=graphical-session.target pipewire-pulse.service
OnFailure=notify-failure@%n.service

[Service]
ExecStart=%h/.local/bin/mic-notify
Restart=on-failure
RestartSec=5

# Sandboxing, same profile as power-notify.service. Measured before writing
# this: one socket, no writes to disk, no device access beyond /dev/null.
# 2 processes (bash, pactl subscribe) since 2026-09-29, 3 before.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077

# AF_UNIX only, and verified rather than assumed: pactl's single socket was
# checked against /proc/net/netlink and is NOT netlink -- it reaches
# pipewire-pulse over a unix socket, the same family notify-send uses.
# PrivateDevices is safe despite the audio subject matter: pactl talks to the
# pipewire daemon, it does not open /dev/snd itself.
RestrictAddressFamilies=AF_UNIX

# REQUIRED, and the reason is a real 2026-09-18 regression, not caution.
# ProtectSystem=strict mounts $XDG_RUNTIME_DIR read-only (verified in
# /proc/self/mountinfo: "ro,nosuid,nodev"), and libpulse creates/validates
# /run/user/1000/pulse before connecting. Without this the unit dies at every
# boot with "Failed to create secure directory (/run/user/1000/pulse):
# Read-only file system", exits 0, and is therefore NOT restarted by
# Restart=on-failure and NOT reported by OnFailure=.
#
# It is invisible twice over: the script pipes pactl's stderr to /dev/null, and
# the first sandbox test passed only because it ran hours into a boot where the
# directory already existed. A reboot is the only thing that exposes it.
# D-Bus is not affected -- connect() to an existing socket works read-only; it
# is the mkdir that fails.
ReadWritePaths=%t

# @system-service must permit fork/execve: each recording's start and end runs
# `pactl list sources short` and `pactl list source-outputs short`.
SystemCallFilter=@system-service

# Deliberately NOT set: CapabilityBoundingSet=. A user service already runs with
# no effective capabilities and NoNewPrivileges blocks acquiring any, so it would
# be redundant -- same reasoning as DropCapability in containers/pg.container.

[Install]
WantedBy=graphical-session.target
