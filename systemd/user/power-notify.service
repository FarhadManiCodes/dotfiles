[Unit]
Description=Power notifications: charger, charge state and battery level
After=graphical-session.target
OnFailure=notify-failure@%n.service

[Service]
# Built from the power-notify submodule by install.sh (make install): a
# freestanding C program that reads kernel uevents and sysfs, and writes nothing.
ExecStart=%h/.local/bin/power-notify
Restart=on-failure
RestartSec=5

# Sandboxing, the notifier profile (docs/architecture/systemd-services.md). Since
# 2026-09-30 (C): 1 process, no writes to disk, no device access; it reads
# /sys/class/power_supply.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077

# AF_NETLINK is mandatory here: the program's only event source is the kernel's
# uevent socket (NETLINK_KOBJECT_UEVENT). Without it the socket fails and the unit
# fails with it. AF_UNIX carries notify-send.
RestrictAddressFamilies=AF_UNIX AF_NETLINK

# @system-service must permit fork/execve (notify-send runs on each notice),
# pidfd_open (@process: the 5 s limit on notify-send) and timerfd (@timer: the
# level timer).
SystemCallFilter=@system-service

# Deliberately NOT set: CapabilityBoundingSet=. A user service already runs with
# no effective capabilities and NoNewPrivileges blocks acquiring any, so it would
# be redundant -- same reasoning as DropCapability in containers/pg.container.

[Install]
WantedBy=graphical-session.target
