[Unit]
Description=Daily archive of Claude Code token usage

[Timer]
# A daily snapshot, not a reaction to a change: a path unit on the transcripts
# would fire on every message.
OnCalendar=daily
# A laptop is often asleep at midnight; run the missed one at the next wake/boot.
Persistent=true
RandomizedDelaySec=15min

[Install]
WantedBy=timers.target
