[Unit]
Description=Network connection notifications
After=graphical-session.target
OnFailure=notify-failure@%n.service

[Service]
ExecStart=%h/.local/bin/net-notify
Restart=on-failure
RestartSec=5

# Sandboxing, same profile as battery-watch.service except the address families.
# This unit is the reason the series exists: it parses SSIDs broadcast by nearby
# access points, so hostile input reaches a bash script. The sandbox does not make
# that parsing safe -- it decides what a parse bug could reach.
# Since 2026-09-29: 2 processes (bash, dbus-monitor), no writes to disk, no device
# access beyond /dev/null; it reads /sys/class/net once to find the wired link.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077

# AF_UNIX only: the system bus (dbus-monitor, iwctl) and the session bus
# (notify-send). Ethernet state comes from systemd-networkd over D-Bus, so netlink
# (`ip monitor`, and networkctl, which fails without it) is no longer needed.
RestrictAddressFamilies=AF_UNIX

# @system-service must permit fork/execve: each event shells out (iwctl, awk,
# notify-send).
SystemCallFilter=@system-service

# Deliberately NOT set: CapabilityBoundingSet=. A user service already runs with
# no effective capabilities and NoNewPrivileges blocks acquiring any, so it would
# be redundant -- same reasoning as DropCapability in containers/pg.container.

[Install]
WantedBy=graphical-session.target
