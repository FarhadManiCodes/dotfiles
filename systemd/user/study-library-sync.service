[Unit]
Description=Sync study library from Google Drive
# No network-online.target ordering, deliberately. An earlier comment here kept the line as
# "correct on a machine that does reach the target"; that was wrong. This is a *user* unit,
# and the user manager has no network-online.target at all (LoadState=not-found) -- so the
# ordering was inert on every machine, not just this one. See rclone@.service for the full
# reasoning. Restart= below is what makes this survive a network-less start.

OnFailure=notify-failure@%n.service

# The common failure is transient, not real: on 2026-09-03 the 06:00 timer ran at 07:27
# after a resume and died on `lookup oauth2.googleapis.com: Temporary failure in name
# resolution`. Three tries five minutes apart let that heal silently. Anything still failing
# after ~10 minutes trips the burst, lands in `failed`, and notifies — which is what the
# previous "no Restart= needed" comment was protecting, just without the false alarms.
# Same shape as rclone@.service, for the same reason.
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=oneshot
Restart=on-failure
RestartSec=5min
IOSchedulingClass=idle
CPUWeight=10
# --progress draws a TTY meter; in a service it lands in the journal as
# carriage-return-mangled redraws. --stats-one-line gives one clean line instead.
# gdrive-full:, not gdrive:. The gdrive combine exists to shrink what the *mount* exposes;
# routing this sync through it means constructing all three upstreams to read one of them —
# on 2026-09-03 a resume-without-network failed here as
# `failed to create upstream "gdrive-full:Documents"` while syncing FAU. This names its path
# explicitly and gains nothing from the combine.
#
# --max-delete: this sync is cloud->local, so a bad state on Drive (or a compromised
# token) would otherwise mirror a mass deletion straight onto the local library with no
# ceiling. The library is ~22 files; deleting more than 5 in one run is anomalous, so the
# unit fails instead and OnFailure=notify-failure@ says so. Raise it deliberately after a
# real reorganisation rather than removing it.
ExecStart=/usr/bin/rclone sync gdrive-full:FAU/Library %h/.local/share/study-library \
    --max-delete 5 \
    --stats 1m --stats-one-line

[Install]
WantedBy=graphical-session.target
