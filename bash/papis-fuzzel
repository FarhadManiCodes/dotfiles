#!/usr/bin/env bash
# Search the papis library with fuzzel and open the pick: its first file with
# xdg-open (PDF and EPUB in sioyek; `papis open` sends everything to sioyek), or its
# DOI/URL in the browser when it has no file (↗).
# `papis-fuzzel --books` (Mod+z) lists entries tagged `book`.
#
# Entries are read straight from info.yaml with yq: accurate list handling for
# tags and files, and no papis (Python) start before the menu.
set -uo pipefail

PAPERS="$HOME/.local/share/papis/papers"
notify() { notify-send -u critical "Papers" "$1"; }

books=0
prompt="  Papers (type a #tag to filter): "
if [[ ${1:-} == --books ]]; then
    books=1
    prompt="  Books (author, title or #tag): "
fi

# Per entry: ref, year, first author, title, folder, first file, tags (joined when
# a list, as is when a plain string: join() fails on a string).
# yq stops at the first unreadable info.yaml, and the papers after it would
# silently be missing from the menu, so a failure is reported instead.
rows=$(yq -o=tsv '[.ref, (.year // ""), (.author_list[0].family // .author // "?"),
        (.title // ""), (filename | sub("info\.yaml$"; "")), (.files[0] // ""),
        ((.tags // []) | (select(tag == "!!seq") | join(" ")) // .)]' "$PAPERS"/*/info.yaml 2>&1) \
    || { notify "Library scan failed: ${rows##*$'\n'}"; exit 1; }
[[ -n $rows ]] || exit 0

# "<what to open> \t <label>": the file's path, or browse:<ref> without one.
# Tags become #words so fuzzel's filter matches them.
menu=$(awk -F'\t' -v books="$books" '{
    if (books && !index(" " $7 " ", " book ")) next
    open = ($6 != "") ? $5 $6 : "browse:" $1
    t = $7; if (t != "") { gsub(/ /, " #", t); t = "  #" t }
    printf "%s\t[%s]  %-16s  %s%s%s\n", open, $2, substr($3, 1, 16), substr($4, 1, 55), ($6 == "") ? " ↗" : "", t
}' <<<"$rows")
[[ -n $menu ]] || exit 0

choice=$(fuzzel --dmenu --only-match --with-nth=2 --accept-nth=1 \
    --prompt "$prompt" --width 100 --lines 15 <<<"$menu")
case $choice in
    '') exit 0 ;;
    browse:*)
        err=$(papis browse "ref:${choice#browse:}" 2>&1) || notify "Could not open it: ${err##*$'\n'}" ;;
    *) open-detached "$choice" ;;
esac
