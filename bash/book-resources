#!/bin/bash

# Library picker (Mod+z).
#
# Reads the LOCAL mirror at ~/.local/share/study-library, not the rclone mount.
# Against the mount a full scan costs a network round trip whenever the
# 5m dir cache is cold, which is why this used to carry a cache file, a
# 10-minute staleness check, a background refresh, and a `sleep 5` pre-warm
# spawned from niri. On the 2026-09-04 13:34 boot that pre-warm ran 85s before
# the mount existed: `>` truncates before find runs and `2>/dev/null` ate the
# error, so the cache became 0 bytes and Mod+z opened an empty picker with no
# explanation.
#
# Against the mirror a full scan is 9ms whether warm or cold -- measured, versus
# 10ms for the mount with its dir cache already warm -- so there is nothing left
# to cache, and all of that machinery is gone rather than guarded. It also means
# the picker AND opening a book work with no network: the files are on disk.
#
# The cost is freshness, and as of 2026-09-18 the mirror is no longer refreshed
# automatically: study-library-sync.service/.timer were removed as unwanted, so
# this is a static local copy. Update it by hand when needed, e.g.
# `rclone sync gdrive-full:FAU/Library ~/.local/share/study-library --max-delete 5`.
LIBRARY="$HOME/.local/share/study-library"

[[ -d "$LIBRARY" ]] || {
    notify-send "Book Resources" "Library missing — ~/.local/share/study-library not found"
    exit 1
}

SELECTION=$(find "$LIBRARY" -mindepth 2 -type f \
        \( -iname '*.pdf' -o -iname '*.djvu' -o -iname '*.epub' \) -printf '%P\n' \
    | sort | fuzzel -d -p "📚 Resources: " -w 120)

[[ -n "$SELECTION" ]] && setsid -f xdg-open "$LIBRARY/$SELECTION" >/dev/null 2>&1
