#!/bin/bash
# One entry point for this repository's test suites.
#
# Every suite runs even after an earlier one fails, so a single broken suite
# cannot hide the state of the rest. Exit 0 = every suite passed.
#
# The checkout is resolved from this script's own real path rather than $PWD or
# $HOME/dotfiles: install.sh symlinks every bash/ file into ~/.local/bin, so the
# invocation path is usually outside the checkout and is not a symlink away from
# it either. Suites are addressed by absolute path for the same reason.
#
# A missing suite is a failure, not a pass: unittest discovery exits 1 on an
# absent directory and bash exits 127 on an absent script, both recorded below.
#
# A suite that passes but reports skipped checks (unittest's "OK (skipped=N)")
# is flagged separately in the summary rather than folded into a plain pass --
# a skip means a check didn't run, which a bare "pass" would hide.

set -uo pipefail

root=$(cd -- "$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")/.." && pwd)
results=()
status=0
output=$(mktemp)
trap 'rm -f "$output"' EXIT

suite() {
  local name=$1
  shift
  printf '\n\033[1m== %s ==\033[0m\n' "$name"
  if "$@" 2>&1 | tee "$output"; then
    if grep -qE '\(skipped=[0-9]+\)' "$output"; then
      results+=("$(printf '\033[33mpass, skips\033[0m  %s' "$name")")
    else
      results+=("$(printf '\033[32mpass\033[0m  %s' "$name")")
    fi
  else
    results+=("$(printf '\033[31mFAIL\033[0m  %s' "$name")")
    status=1
  fi
}

suite unittest python3 -B -m unittest discover -s "$root/tests"
suite skills bash "$root/bash/check-skills"
# The C notifiers are one submodule, notifiers, with a suite per program (net-notify
# and power-notify run theirs in a private network namespace). Each runs as its
# own suite: `make check` would stop at the first that fails. A submodule that
# was never fetched is an empty directory, where make fails: all three FAIL, not
# pass. make's own variables are dropped: an inherited MAKEFLAGS=-n would print
# the recipes instead of running them, and pass.
for prog in mic net power; do
  suite "$prog-notify" env -u MAKEFLAGS -u MFLAGS -u GNUMAKEFLAGS -u MAKEFILES -u MAKELEVEL \
    make -s -C "$root/notifiers" "check-$prog"
done

printf '\n\033[1m== summary ==\033[0m\n'
printf '   %s\n' "${results[@]}"
exit "$status"
