#!/bin/bash
# Power notices: charger and charge state from udev events, battery level on a
# timer that runs only on battery. One notice, replaced in place, shows the
# current state. Replaces batsignal (battery-watch) since 2026-09-29.
#
# Measured on this laptop (2026-09-29): plug/unplug (AC ONLINE) and BAT0 STATUS
# changes are udev events, including "Not charging" with CAPACITY=81 when TLP
# stops at its limit. The level is not: 40 min on battery, zero events. So the
# level is read on a timer, and only while unplugged.

# Settings. The charge limit (81% here) is not one: it is read from TLP's
# charge_control_end_threshold, so it follows the TLP config.
LOW_AT=30 CRITICAL_AT=10 DANGER_AT=5   # alert levels, %
ASSUMED_W=30      # drain the level timer plans for; full CPU load on battery
                  # measured 35.4 W (TLP low-power, no boost), rarely sustained
MAX_WAIT=1200     # s between level checks at most: timers don't count suspend,
                  # and waking up sends no event
PLUG_WINDOW=5     # s: "Charging" this soon after plug-in updates the plug notice

PLUG=$'\U000f06a5' CHG=$'\U000f0084' FULL=$'\U000f0079'
LOW=$'\U000f007b' CRIT=$'\U000f0083' DANG=$'\U000f008e'
sys=${POWER_SYSFS:-/sys/class/power_supply}

bat_icon() {   # battery glyph by level, used when unplugged
    if   (( $1 >= 90 )); then printf '\U000f0079'
    elif (( $1 >= 70 )); then printf '\U000f0081'
    elif (( $1 >= 50 )); then printf '\U000f007e'
    elif (( $1 >= 30 )); then printf '\U000f007b'
    else                      printf '\U000f007a'
    fi
}

# One notice for everything power, each replacing the last (-r).
id=0
show() { id=$(notify-send -p -r "${id:-0}" -a "" -u "$1" -- "$2"); }

read -r ac < "$sys/AC/online"
read -r bstat < "$sys/BAT0/status"
read -r end < "$sys/BAT0/charge_control_end_threshold" 2>/dev/null || end=100

# Seconds per 1% of battery at ASSUMED_W (energy_full is in µWh). batsignal's
# `-m 300` assumed 9 W (300 s per 1%) and at 81% waited 4.25 h, longer than the
# battery lasts at full load.
read -r energy_full < "$sys/BAT0/energy_full"
spp=$(( energy_full * 3600 / (100 * ASSUMED_W * 1000000) ))
(( spp > 0 )) || spp=1

# alerted: the lowest level already announced this discharge (100 = none yet).
# due: when to read the level next ($SECONDS). The wait is the time to the next
# alert level at ASSUMED_W, plus 1% so it lands just past it; at most MAX_WAIT.
alerted=100 due=0 plugged=-100
check_level() {
    local cap next=0 t
    read -r cap < "$sys/BAT0/capacity" || { due=$(( SECONDS + MAX_WAIT )); return; }
    if (( cap <= DANGER_AT && alerted > DANGER_AT )); then
        alerted=$DANGER_AT; show critical "${DANG}  Battery danger — ${cap}%, PLUG IN NOW!"
    elif (( cap <= CRITICAL_AT && alerted > CRITICAL_AT )); then
        alerted=$CRITICAL_AT; show critical "${CRIT}  Battery critical — ${cap}%"
    elif (( cap <= LOW_AT && alerted > LOW_AT )); then
        alerted=$LOW_AT; show normal "${LOW}  Battery low — ${cap}%"
    fi
    for t in "$LOW_AT" "$CRITICAL_AT" "$DANGER_AT"; do
        (( t < alerted && t < cap )) && { next=$t; break; }
    done
    t=$(( next ? (cap - next + 1) * spp : MAX_WAIT ))
    due=$(( SECONDS + (t < MAX_WAIT ? t : MAX_WAIT) ))
}

name='' online='' status='' cap=''
flush() {   # at each udev event boundary (blank line)
    [[ -n $cap ]] || read -r cap < "$sys/BAT0/capacity"
    if [[ $name == AC && -n $online && $online != "$ac" ]]; then
        ac=$online
        if (( ac )); then
            alerted=100 plugged=$SECONDS
            show normal "${PLUG}  Plugged in — ${cap}%"
        else
            show normal "$(bat_icon "$cap")  Unplugged — ${cap}%"
            check_level
        fi
    elif [[ $name == BAT0 && -n $status && $status != "$bstat" ]]; then
        case $status in
            Charging)
                if (( SECONDS - plugged <= PLUG_WINDOW )); then
                    show normal "${PLUG}  Plugged in — ${cap}%, charging"
                else
                    show low "${CHG}  Charging — ${cap}%"
                fi ;;
            "Not charging"|Full)
                # "Not charging" also shows for a moment when the cable is re-seated
                # (seen at 64%); only at the TLP limit does it mean complete.
                [[ $bstat == Charging ]] && (( cap >= end - 1 )) &&
                    show normal "${FULL}  Charging complete — ${cap}%" ;;
        esac
        bstat=$status
    fi
    name='' online='' status='' cap=''
}

while :; do
    rc=0
    if (( ac )); then
        IFS= read -r line || rc=$?
    else
        (( SECONDS >= due )) && check_level
        IFS= read -r -t $(( due - SECONDS )) line || rc=$?
    fi
    (( rc > 128 )) && continue      # timed out: time to read the level
    (( rc == 0 )) || break          # udevadm exited
    case $line in
        '')                      flush ;;
        POWER_SUPPLY_NAME=*)     name=${line#*=} ;;
        POWER_SUPPLY_ONLINE=*)   online=${line#*=} ;;
        POWER_SUPPLY_STATUS=*)   status=${line#*=} ;;
        POWER_SUPPLY_CAPACITY=*) cap=${line#*=} ;;
    esac
done < <(udevadm monitor --subsystem-match=power_supply --udev --property)

# udevadm runs until killed, so reaching here is a failure: exit 1 lets
# Restart= and OnFailure= fire (see docs/architecture/systemd-services.md).
exit 1
