#!/usr/bin/env bash
# sioyek <A-n> -> append a note block to the papis notes.md of the PDF being
# read, then open it in nvim so the thought gets written while it is fresh.
# sioyek <A-N> -> --open: just read the existing notes, appending nothing.
#
# Invoked by sioyek as (see sioyek/prefs_user.config):
#   sioyek-papis-note %{file_path} %{page_number} %{offset_y_document} \
#                     %{selected_text}
#   sioyek-papis-note --open %{file_path}
#
# sioyek splits the command on whitespace BEFORE expanding %{...}, so each
# placeholder is exactly one argv element, spaces and newlines included. The
# selection is optional: without one this still records the page.
#
# %{page_number} is 0-BASED in commands (main_widget.cpp substitutes
# get_current_page_number()), while the status bar shows it + 1 and
# goto_page_with_page_number does stoi(text) - 1. Everything written here is
# 1-based, the number the reader sees. %{current_page_label} is a status-bar
# token only: in a command it arrives as the literal string, which is how it
# once reached a heading.
#
# --open deliberately creates nothing: a keypress meant to check whether notes
# exist should not answer by making an empty one.

set -uo pipefail

notify() {
  notify-send -a sioyek "papis note" "$1" 2>/dev/null
  printf 'sioyek-papis-note: %s\n' "$1" >&2
}

open_only=0
if [ "${1:-}" = "--open" ]; then
  open_only=1
  shift
fi

pdf=${1:-}
page=${2:-}
offset=${3:-}
sel=${4:-}

[ -n "$pdf" ] || { notify "sioyek passed no file path"; exit 1; }

# The papis document folder IS the PDF's directory. A PDF opened from anywhere
# else has no info.yaml, and silently writing a note next to it would be worse
# than saying so.
dir=${pdf%/*}
info="$dir/info.yaml"
[ -f "$info" ] || { notify "not a papis document: ${pdf##*/}"; exit 1; }

# notes-name from the config file rather than `papis config notes-name`: same
# answer, no interpreter start-up on a keypress.
notes_name=$(sed -n '/^notes-name *= */{s///p;q}' "${XDG_CONFIG_HOME:-$HOME/.config}/papis/config" 2>/dev/null)
notes="$dir/${notes_name:-notes.md}"

# Reading starts at the top (+1); a capture starts under the block it appends (+$).
if [ "$open_only" -eq 1 ]; then
  [ -s "$notes" ] || { notify "no notes yet for ${dir##*/} -- press A-n to start one"; exit 0; }
  footclient --app-id papis-note nvim '+1' "$notes" \
    || { notify "could not open $notes"; exit 1; }
  exit 0
fi

# Only the first capture per document pays for papis. `--editor true` is a
# no-op editor: papis still creates the file and writes the `notes:` key, so
# info.yaml is never hand-edited.
if [ ! -f "$notes" ] || ! grep -q '^notes:' "$info"; then
  papis edit --doc-folder "$dir" --notes --editor true >/dev/null 2>&1 \
    || { notify "papis could not create the note"; exit 1; }
  [ -f "$notes" ] || { notify "papis reported success but $notes is missing"; exit 1; }
fi

# A non-numeric page must never leave the heading as a bare "p.".
case $page in
  '' | *[!0-9]*) shown='?' ;;
  *) shown=$((page + 1)) ;;
esac

# Decided before the append opens the file, not while it holds it open.
sep=""
[ -s "$notes" ] && sep=$'\n'
printf -v today '%(%F)T' -1

{
  printf '%s## p.%s — %s\n' "$sep" "$shown" "$today"
  printf '<!--sioyek page=%s offset_y=%s-->\n' "$shown" "$offset"
  # Fenced so papis-ask drops it: the paper's own text is already embedded from
  # the PDF, and embedding it again would crowd out other sources.
  [ -n "$sel" ] && printf '\n<!--quote-->\n> %s\n<!--/quote-->\n' "${sel//$'\n'/$'\n'> }"
  printf '\n'
} >> "$notes" || { notify "could not append to $notes"; exit 1; }

footclient --app-id papis-note nvim '+$' "$notes" \
  || notify "note written, but the editor did not open"
