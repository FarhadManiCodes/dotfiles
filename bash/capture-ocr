#!/usr/bin/env python3
#
# Screen-region OCR via Gemini: `capture-ocr` copies the text exactly,
# `capture-ocr --translate` translates it (to English, or English to German).
# When Gemini can't be reached, plain OCR falls back to GLM-OCR on the local
# GPU through a private llama-server; translation has no local fallback.
# Keep it stdlib-only: this is one HTTP POST with a base64 image, and the SDK
# it used to need cost 109 MB and 265 ms of startup for streaming and auth
# machinery none of this uses. History in revisit.md.

import base64
import fcntl
import json
import os
import re
import secrets
import shlex
import shutil
import signal
import socket
import struct
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from pathlib import Path

MODEL = "gemini-2.5-flash"
TEMPERATURE = 0.0
ENDPOINT = ("https://generativelanguage.googleapis.com/v1beta/models/"
            f"{MODEL}:generateContent")
TIMEOUT = 120
SYNC_HINT = "string:x-canonical-private-synchronous:ocr"

# Offline fallback. Measured 2026-09-25 on this iGPU (revisit.md): 1.2-6.2 s
# per capture including a ~0.9 s server start, ~2.2 GB GPU memory, and it
# invents words on very small print -- which is why it is only the fallback.
LOCAL_MODEL = "ggml-org/GLM-OCR-GGUF:Q8_0"
LOCAL_PROMPT = "Text Recognition:"  # GLM-OCR's own task prompt (model card)
LOCAL_STARTUP = 30
# The local server is on 127.0.0.1: never route it through an http_proxy.
DIRECT = urllib.request.build_opener(urllib.request.ProxyHandler({}))


def notify(title, body, urgency=None, timeout=None):
    """Best-effort desktop notification.

    Never raises. This runs from a niri keybinding with no terminal attached,
    so if notify-send is missing or fails, a check_call here would replace the
    error being reported with a traceback nobody can see. stderr is the
    fallback -- useless from a keybinding, but visible when run by hand.
    """
    cmd = ["notify-send", "-h", SYNC_HINT]
    if urgency:
        cmd += ["-u", urgency]
    if timeout:
        cmd += ["-t", str(timeout)]
    try:
        subprocess.run(cmd + [title, body], check=False)
    except OSError:
        print(f"{title}: {body}", file=sys.stderr)


def fail(message):
    notify("OCR Failed", message, urgency="critical")
    sys.exit(1)


def single_instance():
    """Exit if another run is active; otherwise hold the lock until exit.

    A second press of either key during a selection or a request would stack
    another slurp on top of the first; it only says so instead, since a key
    that does nothing for up to TIMEOUT seconds looks broken. The kernel drops
    a flock when its holder exits, crash included, so no stale lock survives.
    Without a usable XDG_RUNTIME_DIR (never the case under niri) run unlocked
    rather than pick a shared directory another user could squat on.
    """

    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime:
        return
    # A bare fd, not a file object, so nothing closes it before exit.
    try:
        fd = os.open(os.path.join(runtime, "capture-ocr.lock"),
                     os.O_WRONLY | os.O_CREAT | os.O_CLOEXEC, 0o600)
    except OSError:
        return  # unusable runtime dir: a lost lock beats a silent traceback
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        notify("OCR", "Already running", timeout=2000)
        sys.exit(0)


def api_key():
    """Searched in order, so the key need not be paper-refinery's.

    Deliberately NOT copied into a second file: these keys exist only on this
    disk and are covered by no backup (see CLAUDE.md), so a duplicate is one
    more thing to rotate and one more thing to go stale.
    """
    key = os.environ.get("GOOGLE_API_KEY")
    if key:
        return key
    searched = []
    for env_file in (Path.home() / ".config/capture-ocr/google.env",
                     Path.home() / ".config/paper-refinery/secrets/google.env"):
        searched.append(env_file)
        if not env_file.exists():
            continue
        for line in env_file.read_text().splitlines():
            if line.startswith("GOOGLE_API_KEY="):
                return line.split("=", 1)[1].strip().strip('"').strip("'")
    fail("GOOGLE_API_KEY not set and not in " +
         " or ".join(str(f).replace(str(Path.home()), "~") for f in searched))


def capture():
    """Select a region and grab it. Returns PNG bytes, or exits.

    slurp and grim are kept in separate try blocks on purpose: a non-zero slurp
    is the user pressing ESC and must stay silent, while a non-zero grim is a
    real failure and must say so. Collapsing them into one handler makes a
    broken capture indistinguishable from a deliberate cancel.
    """
    try:
        geom = subprocess.check_output(["slurp"], text=True).strip()
    except subprocess.CalledProcessError:
        sys.exit(0)  # ESC / no selection -- deliberate cancel
    except OSError:
        fail("slurp is not installed.")

    try:
        return subprocess.check_output(["grim", "-g", geom, "-"])
    except subprocess.CalledProcessError as e:
        fail(f"grim could not capture region '{geom}' (exit {e.returncode}).")
    except OSError:
        fail("grim is not installed.")


# Two keys, two prompts: one prompt that both transcribed and translated had to
# guess which the user wanted, and translated German it was only asked to copy.
# Shared rules keep the modes from drifting apart. Raw strings: the rules hold
# LaTeX, and "\tag" in a plain string is a tab. Measured against the old
# combined prompt in revisit.md.
RULES = r"""Rules:
1. Output ONLY the resulting text: no preamble, notes or explanations, and do not wrap the whole output in a code block.
2. Plain text: do not add Markdown formatting for bold, italics or headings. Characters that are part of the text itself, such as _ * # in code or shell commands, are kept. Keep list markers and numbering as shown.
3. Mathematics: write formulas, equations and matrices as LaTeX. Math inside a sentence uses `$...$`. An equation set on its own line uses `$$...$$`, with no newline directly inside `$$`, and its equation number becomes `\tag{...}`. Other symbols and icons (arrows, check marks, bullets) are copied as the character itself, not LaTeX.
4. Keep the original structure: paragraph breaks, list items and line order.
5. Never add, drop or silently correct content. If some text is illegible, write [illegible] in its place instead of guessing. If the image contains no text at all, output nothing."""

OCR_PROMPT = r"""Transcribe all text in this image exactly as written, in its original language. Do not translate anything. Keep spelling, including typos, exactly as shown.

""" + RULES

TRANSLATE_PROMPT = r"""Translate the text in this image.
- Decide the source language from the dominant language of the text.
- If it is not English (German, Persian or any other language), translate it into English.
- If it is English, translate it into German.
- Do not translate code, commands, file names, paths, URLs, identifiers or mathematics; copy them exactly.
- Keep names of people, organisations and products as written, and keep citations as written.
- Match the register of the source: academic text stays academic. Write fluent, natural text in the target language, not a word-for-word rendering.

""" + RULES


class Unreachable(Exception):
    """Gemini could not be contacted at all, as opposed to answering badly."""


def transcribe(img_bytes, key, prompt):
    """One POST. Returns (text, truncated); raises Unreachable."""
    body = json.dumps({
        "contents": [{
            "role": "user",
            "parts": [
                # grim writes png by default (grim -h); keep these in step.
                {"inline_data": {"mime_type": "image/png",
                                 "data": base64.b64encode(img_bytes).decode()}},
                {"text": prompt},
            ],
        }],
        "generationConfig": {"temperature": TEMPERATURE},
    }).encode()

    req = urllib.request.Request(
        ENDPOINT, data=body,
        headers={"Content-Type": "application/json",
                 # Header, not ?key= -- a query string lands in logs and proxies.
                 "x-goog-api-key": key})
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
            payload = json.loads(r.read())
    except urllib.error.HTTPError as e:
        detail = ""
        try:
            detail = json.loads(e.read()).get("error", {}).get("message", "")
        except Exception:
            pass
        fail(f"Gemini returned {e.code}. {detail}".strip())
    except urllib.error.URLError as e:
        raise Unreachable(e.reason) from None
    except (TimeoutError, OSError) as e:
        raise Unreachable(e) from None

    candidates = payload.get("candidates") or []
    if not candidates:
        # A prompt-level block returns no candidate at all.
        blocked = (payload.get("promptFeedback") or {}).get("blockReason")
        fail(f"No response from Gemini{f' ({blocked})' if blocked else ''}.")
    cand = candidates[0]
    parts = (cand.get("content") or {}).get("parts") or []
    text = "".join(p.get("text", "") for p in parts).strip()
    # Thinking tokens count against the output limit, so a large capture can
    # stop mid-sentence in an otherwise successful-looking response. Measured
    # 2026-09-08: a 256-token limit returned 39 characters of a 3316-character
    # page, and without this check those 39 characters were copied and
    # announced as "OCR Copied". Truncation must never look like success.
    return text, cand.get("finishReason") == "MAX_TOKENS"


def png_size(img_bytes):
    """(width, height) from the IHDR chunk, which a PNG must start with."""
    return struct.unpack(">II", img_bytes[16:24])


def free_port():
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


def local_transcribe(img_bytes):
    """GLM-OCR through a private llama-server started for this one capture.

    Returns (text, truncated). The server lives only as long as this call:
    it loads in about a second once the model is in the page cache, so
    nothing stays resident holding GPU memory.
    """
    binary = shutil.which("llama-server")
    if binary is None:
        fail("Gemini unreachable, and llama-server is not installed for the offline fallback.")
    # --offline never downloads, so check the cache first for a useful message.
    listed = subprocess.run([binary, "--cache-list"], capture_output=True, text=True)
    if LOCAL_MODEL not in listed.stdout:
        fail(f"Gemini unreachable, and the offline model is not downloaded. Once "
             f"online, run: llama-server -hf {LOCAL_MODEL} (Ctrl+C when it is listening).")

    port = free_port()
    # Any local user can reach a localhost port; the key keeps the server ours.
    key = secrets.token_urlsafe(16)
    server = shlex.join([
        binary, "-hf", LOCAL_MODEL, "--offline", "-ngl", "99", "-c", "8192",
        "-np", "1", "--host", "127.0.0.1", "--port", str(port)])
    # A bash supervisor also watches our pid, so a SIGKILLed or SIGTERMed
    # capture-ocr (no finally runs) can't leave the server holding GPU memory.
    watchdog = (f"{server} & srv=$!; tail --pid={os.getpid()} -f /dev/null & "
                "watch=$!; wait -n; kill -KILL $srv $watch 2>/dev/null; wait")
    log = tempfile.TemporaryFile()
    proc = subprocess.Popen(
        ["bash", "-c", watchdog], stdin=subprocess.DEVNULL, stdout=log, stderr=log,
        start_new_session=True,
        # Via the environment, not argv: /proc/<pid>/cmdline is world-readable.
        env={**os.environ, "LLAMA_API_KEY": key})
    base = f"http://127.0.0.1:{port}"
    try:
        deadline = time.monotonic() + LOCAL_STARTUP
        while True:
            if proc.poll() is not None:
                log.seek(0)
                lines = log.read().decode(errors="replace").strip().splitlines()
                fail("Offline model failed to start: " + " | ".join(lines[-2:]))
            if time.monotonic() > deadline:
                fail(f"Offline model not ready after {LOCAL_STARTUP} s.")
            try:
                with DIRECT.open(base + "/health", timeout=1) as r:
                    if r.status == 200:
                        break
            except urllib.error.HTTPError as e:  # 503 while the model loads
                e.close()
            except (urllib.error.URLError, OSError):
                pass
            time.sleep(0.05)

        width, height = png_size(img_bytes)
        body = json.dumps({
            "messages": [{"role": "user", "content": [
                {"type": "image_url", "image_url": {
                    "url": "data:image/png;base64," + base64.b64encode(img_bytes).decode()}},
                {"type": "text", "text": LOCAL_PROMPT}]}],
            "temperature": 0,
            # A cap against runaway repetition. The densest page measured needed
            # about one token per 500 px^2; this allows 2.5x that.
            "max_tokens": 64 + width * height // 200,
        }).encode()
        req = urllib.request.Request(
            base + "/v1/chat/completions", data=body,
            headers={"Content-Type": "application/json", "Authorization": f"Bearer {key}"})
        try:
            with DIRECT.open(req, timeout=TIMEOUT) as r:
                choice = json.load(r)["choices"][0]
        except (urllib.error.URLError, OSError) as e:
            fail(f"Offline model request failed: {e}")
    finally:
        # The whole group: bash, the server and the watchdog's tail.
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        proc.wait()
        log.close()

    text = (choice.get("message") or {}).get("content") or ""
    # Measured: blank crops come back as an empty ```markdown fence or "---".
    fence = re.fullmatch(r"\s*```\w*\n?(.*?)\n?```\s*", text, re.S)
    if fence:
        text = fence.group(1)
    if not re.search(r"\w", text):
        text = ""
    return text.strip(), choice.get("finish_reason") == "length"


def main():
    args = sys.argv[1:]
    if args not in ([], ["--translate"]):
        fail(f"Unknown arguments: {' '.join(args)}. Usage: capture-ocr [--translate]")
    translate = bool(args)
    single_instance()
    key = api_key()
    img_bytes = capture()
    notify("OCR", f"{'Translating' if translate else 'Extracting'} text via Gemini...",
           timeout=3000)

    offline = False
    try:
        text, truncated = transcribe(img_bytes, key,
                                     TRANSLATE_PROMPT if translate else OCR_PROMPT)
    except Unreachable as e:
        if translate:
            fail(f"Could not reach Gemini ({e}); translation needs the network.")
        notify("OCR", f"Gemini unreachable ({e}); reading it offline with GLM-OCR...",
               timeout=3000)
        text, truncated = local_transcribe(img_bytes)
        offline = True
    # Measured 2026-09-25: on a blank dark crop, 1 of 5 runs answered
    # "[illegible]" despite rule 5. A marker with no text around it is no text.
    if not text.replace("[illegible]", "").strip():
        text = ""

    if not text:
        if truncated:
            fail("Hit the output token limit before producing any text.")
        notify("OCR", "No text found")
        sys.exit(0)

    try:
        subprocess.run(["wl-copy"], input=text.encode("utf-8"), check=True)
    except (subprocess.CalledProcessError, OSError) as e:
        fail(f"Could not copy to clipboard: {e}")

    notify_text = text if len(text) < 150 else text[:147] + "..."
    done = ("Translation Copied" if translate
            else "OCR Copied (offline)" if offline else "OCR Copied")
    if truncated:
        notify(f"{done} - TRUNCATED", f"Hit the output token limit; text is "
               f"incomplete. Capture a smaller region.\n{notify_text}",
               urgency="critical")
    else:
        notify(done, notify_text)


if __name__ == "__main__":
    main()
