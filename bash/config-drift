#!/bin/bash
# Report config that upstream has moved out from under.
#
# The failure this exists for is silent by construction: a package or plugin
# ships a new version, your settings keep the old shape, and nothing errors --
# it just quietly does less. Two instances in one week prompted it. tmux-power
# stopped honouring @tmux_power_time_format, so the clock started showing
# seconds; and nine .pacnew files had been accumulating since May, the oldest
# four months old, because nothing ever looked for them.
#
# Read-only. Needs no root. Prints a report; changes nothing.
#
# Deliberately NOT here: "is my option still read by the plugin?", answered by
# grepping the plugin for the option name. It does not work. tmux-power reads
# every @tmux_power_* through one batched regex and never names an option in its
# source, so that check reports every option as dead. Worse, the regression it
# was meant to catch would have passed: the option was still read into a
# variable, and only the code that used it was replaced by a hardcoded value.
# Assert on rendered behaviour instead -- see the tmux section below.

set -uo pipefail
verbose=0
[[ ${1:-} == -v || ${1:-} == --verbose ]] && verbose=1
issues=0
df_dir=${DOTFILES:-$HOME/dotfiles}

hdr() { printf '\n\033[1m== %s ==\033[0m\n' "$1"; }
ok()   { printf '   \033[32mok\033[0m  %s\n' "$1"; }
warn() { printf '   \033[33m!!\033[0m  %s\n' "$1"; issues=$((issues+1)); }

# ---------------------------------------------------------------- .pacnew ----
hdr "Pending .pacnew"
if ! command -v pacdiff >/dev/null 2>&1; then
  warn "pacdiff not installed (pacman-contrib)"
else
  mapfile -t pending < <(pacdiff --output 2>/dev/null)
  if ((${#pending[@]} == 0)); then
    ok "none pending"
  else
    warn "${#pending[@]} file(s) need merging — review with: sudo pacdiff"
    for f in "${pending[@]}"; do
      base=${f%.pacnew}
      if [[ -r $f && -r $base ]]; then
        n=$(diff "$base" "$f" 2>/dev/null | grep -c '^[<>]')
        age=$(( ( $(date +%s) - $(stat -c %Y "$f") ) / 86400 ))
        printf '       %-46s %4s changed lines, %s days old\n' "${f#/etc/}" "$n" "$age"
        if ((verbose)); then
          diff -u "$base" "$f" 2>/dev/null | sed -n '3,$p' | sed 's/^/         /'
        fi
      else
        printf '       %-46s (unreadable)\n' "${f#/etc/}"
      fi
    done
    ((verbose)) || echo "       (re-run with -v for full diffs)"
  fi
fi

# ------------------------------------------------- root configs installed ----
# install-root.sh COPIES these rather than symlinking (a PAM auth file must not
# point at a user-writable path; sysctl.d and zram-generator.conf are read at
# boot before $HOME is guaranteed). A copy diverges silently, in either
# direction: edit the repo and forget to re-run install-root.sh, or edit /etc by
# hand and never sync it back. Neither errors, and .pacnew does not catch it --
# these files are unowned by any package, which is exactly why they are here.
hdr "Root configs match the repo"
drift=0
check_root() {   # $1 repo path, $2 installed path
  local src=$1 dest=$2
  if [[ ! -e $dest ]]; then
    warn "${dest} is NOT installed — run: sudo bash install-root.sh"; drift=1
  elif [[ ! -r $dest ]]; then
    # Root-only file (the two snapper configs are 0640 root:root). Try sudo, but
    # only with -n, which never prompts and fails instantly when no timestamp is
    # cached -- this script must stay runnable without root and must never hang
    # waiting for a password. In practice it often succeeds inside sysup, which
    # runs `sudo fwupdmgr refresh` immediately before this.
    #
    # The two sudo calls are deliberate, not redundant: `cmp` alone cannot
    # distinguish "files differ" from "sudo refused", both of which exit
    # non-zero. Establishing readability first means a difference is only ever
    # reported when the file was genuinely read. Claiming a verdict for a file
    # that was never opened is precisely the failure this script exists to catch.
    if sudo -n test -r "$dest" 2>/dev/null; then
      if ! sudo -n cmp -s "$src" "$dest"; then
        if [[ $src -nt $dest ]]; then
          warn "${dest} is behind ${src#"$df_dir"/} (read as root) — run: sudo bash install-root.sh"
        else
          warn "${dest} was changed live (read as root) — copy it back to ${src#"$df_dir"/}"
        fi
        drift=1
      fi
    else
      printf '   \033[34m--\033[0m  %s needs root to read — not compared\n' "$dest"
    fi
  elif ! cmp -s "$src" "$dest"; then
    if [[ $src -nt $dest ]]; then
      warn "${dest} is behind ${src#"$df_dir"/} — run: sudo bash install-root.sh"
    else
      warn "${dest} was changed live — copy it back to ${src#"$df_dir"/}"
    fi
    drift=1
  fi
}
while read -r src; do
  check_root "$src" "/etc${src#"$df_dir"/etc}"
done < <(find "$df_dir/etc" -type f ! -name README.md 2>/dev/null)
check_root "$df_dir/pam/swaylock"               /etc/pam.d/swaylock
check_root "$df_dir/sysctl/99-performance.conf" /etc/sysctl.d/99-performance.conf
check_root "$df_dir/zram/zram-generator.conf"   /etc/systemd/zram-generator.conf
check_root "$df_dir/system-sleep/unblock-fuse"  /usr/lib/systemd/system-sleep/unblock-fuse

# A sleep hook that has lost +x is installed, up to date, and dead: systemd-sleep
# runs only executables and says nothing about the rest. That is how
# restart-swayidle sat inert through 1002 resumes. install-root.sh warns too, but
# only when someone runs it with sudo; this runs after every sysup.
for f in "$df_dir"/system-sleep/*; do
  hook=/usr/lib/systemd/system-sleep/${f##*/}
  if [[ -e $hook && ! -x $hook ]]; then
    warn "${hook} is not executable — systemd-sleep will skip it"; drift=1
  fi
done
((drift)) || ok "all tracked root configs match their installed copies"

# ------------------------------------------------------- plugin staleness ----
hdr "Plugins behind upstream"
stale=0
for d in ~/.config/tmux/plugins/*/ ~/.config/zsh/plugins/*/ ~/.vim/plugged/*/; do
  [[ -d $d/.git ]] || continue
  name=$(basename "$d")
  branch=$(git -C "$d" rev-parse --abbrev-ref HEAD 2>/dev/null) || continue
  behind=$(git -C "$d" rev-list --count "HEAD..origin/$branch" 2>/dev/null) || continue
  if [[ ${behind:-0} -gt 0 ]]; then
    warn "$name is $behind commits behind origin/$branch"
    stale=1
  fi
done
((stale)) || ok "all plugins current (as of the last fetch — sysup refreshes them)"

# nvim is deliberately NOT in the loop above, and "behind origin" is the wrong
# question for it. lazy.nvim pins every plugin to nvim/lazy-lock.json, so being
# behind upstream is what pinning *means* -- that check would flag all 37 forever,
# the same mistake as grepping tmux-power for option names. The signal that
# actually carries information is how long the lockfile has sat still: nvim was
# missing from sysup until 2026-09-04, which left it untouched from 25 July with
# nothing to say so.
#
# That signal is reliable rather than incidental: lazy's manage/lock.lua opens the
# lockfile "wb" unconditionally on every sync, with no content comparison, so the
# mtime always moves when a sync runs. An old lockfile therefore means nvim was
# not synced -- it cannot mean "synced, but nothing upstream changed".
lock="$df_dir/nvim/lazy-lock.json"
if [[ -f $lock ]]; then
  age=$(( ( $(date +%s) - $(stat -c %Y "$lock") ) / 86400 ))
  n=$(grep -c '{ "branch"\|": {' "$lock" 2>/dev/null)
  if ((age > 60)); then
    warn "nvim: lazy-lock.json untouched for ${age} days (${n} plugins pinned)"
    echo  "       refresh with: nvim --headless '+Lazy! sync' +qa   (sysup does this)"
  else
    ok "nvim: ${n} plugins pinned, lockfile ${age} days old"
  fi
else
  ok "nvim: no lazy-lock.json — not using lazy.nvim"
fi

# ------------------------------------------------ tmux rendered behaviour ----
# Assert on what the bar actually renders, not on which options are set. This is
# the check that would have caught the clock regression: the option stayed set
# and stayed read, while the value stopped being used.
hdr "tmux status bar renders as configured"
if ! tmux info >/dev/null 2>&1; then
  ok "no tmux server running — nothing to check"
else
  right=$(tmux display-message -p '#{E:status-right}' 2>/dev/null)
  if [[ $right =~ [0-9]{2}:[0-9]{2}:[0-9]{2} ]]; then
    warn "clock is rendering seconds — @tmux_power_time_format is being ignored"
  elif [[ $right =~ [0-9]{2}:[0-9]{2} ]]; then
    ok "clock renders as HH:MM"
  else
    warn "could not find a clock in status-right: ${right:0:60}"
  fi
  if [[ $right =~ [0-9]{4}-[0-9]{2}-[0-9]{2} ]]; then
    warn "date is rendering ISO — @tmux_power_date_format is being ignored"
  else
    ok "date is not rendering ISO"
  fi
fi

# ------------------------------------------------------ systemd unit files ----
hdr "systemd user units verify"
bad=0
for u in "$df_dir"/systemd/user/*.{service,timer}; do
  [[ -e $u ]] || continue
  out=$(systemd-analyze verify "$u" 2>&1 | grep -vE "Unknown key name .*in section 'Quadlet'|^$")
  if [[ -n $out ]]; then
    warn "$(basename "$u"): ${out%%$'\n'*}"
    bad=1
  fi
done
((bad)) || ok "all unit files verify clean"

# ------------------------------------------------------------------ summary --
printf '\n'
if ((issues == 0)); then
  printf '\033[32mNo drift found.\033[0m\n'
else
  printf '\033[33m%d item(s) need attention.\033[0m\n' "$issues"
fi
exit 0
