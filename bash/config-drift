#!/bin/bash
# Report config that upstream has moved out from under.
#
# See docs/architecture/config-drift.md for why this exists and the
# grep-vs-rendered-behaviour lesson behind what's deliberately not here.
#
# Read-only. Needs no root. Prints a report; changes nothing.

set -uo pipefail
verbose=0
pacman_since=''
issues=0
skipped=0
now=$(date +%s)
export LC_ALL=C
shopt -s nullglob
df_dir=${DOTFILES:-$HOME/dotfiles}

hdr() { printf '\n\033[1m== %s ==\033[0m\n' "$1"; }
ok()   { printf '   \033[32mok\033[0m  %s\n' "$1"; }
skip() { printf '   \033[34m--\033[0m  %s\n' "$1"; skipped=$((skipped+1)); }
warn() { printf '   \033[33m!!\033[0m  %s\n' "$1"; issues=$((issues+1)); }

# Checks too big to keep inline live one-per-file in config-drift.d/, found
# through this script's own real path (install.sh symlinks bash/* into
# ~/.local/bin, so neither $PWD nor the invocation path locates the checkout —
# same reasoning and pattern as bash/run-tests and bash/check-skills).
checks_dir=$(cd -- "$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")/config-drift.d" && pwd)
# shellcheck source=bash/config-drift.d/symlink-integrity.sh
source "$checks_dir/symlink-integrity.sh"
# shellcheck source=bash/config-drift.d/etc-baselines.sh
source "$checks_dir/etc-baselines.sh"
# shellcheck source=bash/config-drift.d/pacman-transaction.sh
source "$checks_dir/pacman-transaction.sh"
# shellcheck source=bash/config-drift.d/spotify.sh
source "$checks_dir/spotify.sh"
unset checks_dir

check_pacnew() {
  hdr "Pending .pacnew"
  if ! command -v pacdiff >/dev/null 2>&1; then
    warn "pacdiff not installed (pacman-contrib)"
  else
    if ! pending_output=$(pacdiff --output 2>/dev/null); then
      warn "pacdiff failed — pending files were not checked"
    elif [[ -z $pending_output ]]; then
      ok "none pending"
    else
      mapfile -t pending <<<"$pending_output"
      warn "${#pending[@]} file(s) need merging — review with: sudo pacdiff"
      for f in "${pending[@]}"; do
        base=${f%.pacnew}
        if [[ -r $f && -r $base ]]; then
          n=$(diff "$base" "$f" 2>/dev/null | grep -c '^[<>]')
          age=$(( ( now - $(stat -c %Y "$f") ) / 86400 ))
          printf '       %-46s %4s changed lines, %s days old\n' "${f#/etc/}" "$n" "$age"
          if ((verbose)); then
            diff -u "$base" "$f" 2>/dev/null | sed -n '3,$p' | sed 's/^/         /'
          fi
        else
          printf '       %-46s (unreadable)\n' "${f#/etc/}"
        fi
      done
      ((verbose)) || echo "       (re-run with -v for full diffs)"
    fi
  fi
}

# install-root.sh COPIES these rather than symlinking (a PAM auth file must not
# point at a user-writable path; sysctl.d and zram-generator.conf are read at
# boot before $HOME is guaranteed) — see docs/architecture/config-drift.md for
# why that means checking them here.
check_root() {   # $1 repo path, $2 installed path
  local src=$1 dest=$2 result
  local -a reader=()
  if [[ ! -r $src ]]; then
    warn "${src#"$df_dir"/} is unreadable or missing — not compared"; drift=1
    return
  fi
  if [[ ! -r $dest ]]; then
    # Use cached sudo credentials only. Without access, existence itself may
    # be unknowable (e.g. a file beneath a root-only directory).
    if sudo -n test -r "$dest" 2>/dev/null; then
      reader=(sudo -n)
    elif [[ -x ${dest%/*} && ! -e $dest ]]; then
      warn "$dest is NOT installed — review install-root.sh"; drift=1
      return
    else
      skip "$dest needs access to read — not compared"
      return
    fi
  fi
  "${reader[@]}" cmp -s -- "$src" "$dest"
  result=$?
  case $result in
    0) ;;
    1) warn "$dest differs from ${src#"$df_dir"/} — review both before syncing"; drift=1 ;;
    *) warn "$dest comparison failed — not compared"; drift=1 ;;
  esac
}

check_root_configs() {
  hdr "Root configs match the repo"
  drift=0
  # README.md documents the tree; unowned.txt and modified.txt are baselines for
  # the sweep above. All three are repo metadata that installs nowhere -- without
  # excluding them this check demands /etc/unowned.txt and never goes green.
  if root_files=$(find "$df_dir/etc" -type f \
      ! -name README.md ! -name unowned.txt ! -name modified.txt 2>/dev/null); then
    while IFS= read -r src; do
      [[ -n $src ]] && check_root "$src" "/etc${src#"$df_dir"/etc}"
    done <<<"$root_files"
  else
    warn "cannot enumerate tracked etc/ configs"; drift=1
  fi
  check_root "$df_dir/pam/swaylock"               /etc/pam.d/swaylock
  check_root "$df_dir/sysctl/99-performance.conf" /etc/sysctl.d/99-performance.conf
  check_root "$df_dir/zram/zram-generator.conf"   /etc/systemd/zram-generator.conf
  check_root "$df_dir/system-sleep/unblock-fuse"  /usr/lib/systemd/system-sleep/unblock-fuse

  ((drift)) || ok "all compared root configs match (access exclusions listed above)"
}

# The check above answers "is this the file I wrote?". It cannot answer "can
# anyone else rewrite it?" -- a 0666 sysctl.d drop-in, or a pam.d entry replaced
# by a symlink into $HOME, compares byte-identical and is still a way in.
# install-root.sh copies with explicit root:root modes precisely so these stay
# out of user-writable space; this reports when that has stopped being true.
#
# Report-only, like the rest of this script. Repairing a privileged file is
# install-root.sh's job, run knowingly under sudo -- a checker that edits /etc is
# a checker that needs root, and this one deliberately does not.
#
# stat needs only search permission on the parents, not read on the file, so
# ownership and mode are answerable here even where the content check had to
# skip. Where it is not answerable, say so: unreadable is never reported as safe.

# A root-owned file inside a directory someone else can write is not protected:
# the file cannot be edited, but it can be renamed away and replaced.
check_parents() {
  local d=${1%/*} meta owner mode
  while [[ -n $d ]]; do
    if [[ -z ${parent_seen[$d]:-} ]]; then
      parent_seen[$d]=1
      if meta=$(stat -c '%U %a' -- "$d" 2>/dev/null); then
        read -r owner mode <<<"$meta"
        if [[ $owner != root ]]; then
          warn "$d is owned by $owner — its contents can be replaced"; priv=1
        elif ((8#$mode & 022)); then
          warn "$d is mode $mode — group/world-writable directory"; priv=1
        fi
      else
        skip "$d metadata unreadable — not checked"
      fi
    fi
    d=${d%/*}
  done
}

# $2 = exec when the file is only useful if it is executable. A sleep hook that
# has lost +x is installed, up to date, and dead: systemd-sleep runs only
# executables and says nothing about the rest. That is how restart-swayidle sat
# inert through 1002 resumes. install-root.sh warns too, but only when someone
# runs it with sudo; this runs after every sysup.
check_privileged() {
  local dest=$1 need_exec=${2:-} meta owner group mode kind
  if [[ -L $dest ]]; then
    warn "$dest is a symlink — install-root.sh copies; a link can leave root-owned space"
    priv=1; return
  fi
  if ! meta=$(stat -c '%U %G %a %F' -- "$dest" 2>/dev/null); then
    skip "$dest metadata unreadable — not checked"; return
  fi
  read -r owner group mode kind <<<"$meta"
  [[ $kind == "regular file" ]] || { warn "$dest is a $kind, not a regular file"; priv=1; }
  [[ $owner == root && $group == root ]] || { warn "$dest is $owner:$group, not root:root"; priv=1; }
  ((8#$mode & 022)) && { warn "$dest is mode $mode — writable by group or others"; priv=1; }
  [[ $need_exec == exec && ! -x $dest ]] && \
    { warn "$dest is mode $mode — not executable, so it will be skipped"; priv=1; }
  check_parents "$dest"
}

check_privileged_configs() {
  hdr "Root configs are root-owned and unwritable by others"
  priv=0
  declare -A parent_seen=()

  while IFS= read -r src; do
    [[ -n $src ]] && check_privileged "/etc${src#"$df_dir"/etc}"
  done < <(find "$df_dir/etc" -type f \
      ! -name README.md ! -name unowned.txt ! -name modified.txt 2>/dev/null)
  check_privileged /etc/pam.d/swaylock
  check_privileged /etc/sysctl.d/99-performance.conf
  check_privileged /etc/systemd/zram-generator.conf
  check_privileged /usr/share/wayland-sessions/niri-isolated.desktop
  check_privileged /usr/local/bin/niri-session-isolated exec
  for f in "$df_dir"/system-sleep/*; do
    check_privileged "/usr/lib/systemd/system-sleep/${f##*/}" exec
  done
  ((priv)) || ok "root-owned, not writable by others, under root-owned directories"
}

check_plugin_staleness() {
  hdr "Plugins behind upstream"
  stale=0
  plugin_count=0
  for d in "${XDG_CONFIG_HOME:-$HOME/.config}"/tmux/plugins/*/ "${XDG_CONFIG_HOME:-$HOME/.config}"/zsh/plugins/*/ ~/.vim/plugged/*/; do
    [[ -e $d/.git ]] || continue
    name=${d%/}; name=${name##*/}
    # Use the configured upstream, including non-origin remotes and differently
    # named branches. No fetch here: sysup owns network updates.
    if behind=$(git -C "$d" rev-list --count 'HEAD..@{upstream}' 2>/dev/null); then
      plugin_count=$((plugin_count+1))
      if ((behind > 0)); then
        warn "$name is $behind commits behind its upstream"; stale=1
      fi
    else
      skip "$name: upstream unavailable — not compared"; stale=1
    fi
  done
  if ((plugin_count == 0)); then
    skip "no plugin repositories could be compared"
  elif ((stale == 0)); then
    ok "$plugin_count plugins current (as of the last fetch — sysup refreshes them)"
  fi

  # nvim is deliberately not in the loop above — see docs/architecture/neovim.md
  # for why "behind upstream" is the wrong question for a pinned lockfile. Age
  # is a reminder, not proof of a successful sync (checkout/restore/touch also
  # change mtime) — don't read a recent timestamp as "plugins are current".
  lock="$df_dir/nvim/lazy-lock.json"
  if [[ -f $lock ]]; then
    age=$(( ( now - $(stat -c %Y "$lock") ) / 86400 ))
    n=$(grep -c '{ "branch"\|": {' "$lock" 2>/dev/null)
    if ((age > 60)); then
      warn "nvim: lazy-lock.json untouched for ${age} days (${n} plugins pinned)"
      echo  "       refresh with: nvim --headless '+Lazy! sync' +qa   (sysup does this)"
    else
      ok "nvim: ${n} plugins pinned, lockfile ${age} days old"
    fi
  else
    warn "nvim: lazy-lock.json missing — pinned plugins not checked"
  fi
}

check_systemd_units() {
  hdr "systemd user units verify"
  units=("$df_dir"/systemd/user/*.{service,timer})
  if ((${#units[@]} == 0)); then
    skip "no user unit files to verify"
  else
    # Verify together in user-manager scope: resolves sibling units correctly and
    # avoids initializing the verifier separately for each file. Preserve its status.
    unit_status=0
    out=$(systemd-analyze --user verify "${units[@]}" 2>&1) || unit_status=$?
    if ((unit_status != 0)) || [[ -n $out ]]; then
      warn "user unit verification needs attention (exit $unit_status)"
      if ((verbose)); then
        printf '%s\n' "$out"
      else
        printf '       %s\n' "${out%%$'\n'*}"
        echo "       (re-run with -v for the full report)"
      fi
    else
      ok "${#units[@]} user unit files verify clean"
    fi
  fi
}

main() {
  while (($#)); do
    case $1 in
      -v|--verbose) verbose=1; shift ;;
      --pacman-since)
        if (($# < 2)) || [[ ! $2 =~ ^[0-9]+:[0-9]+:[0-9]+$ && $2 != unavailable ]]; then
          echo "config-drift: --pacman-since requires a device:inode:bytes boundary" >&2
          exit 2
        fi
        pacman_since=$2; shift 2 ;;
      *) echo "config-drift: unknown argument: $1" >&2; exit 2 ;;
    esac
  done

  check_pacnew
  check_last_pacman_transaction
  check_root_configs
  check_privileged_configs
  check_spotify_config
  check_etc_baselines
  check_symlink_integrity
  check_plugin_staleness
  check_systemd_units

  printf '\n'
  if ((issues == 0 && skipped == 0)); then
    printf '\033[32mNo drift found.\033[0m\n'
  else
    printf '\033[33m%d item(s) need attention; %d check(s) incomplete/skipped.\033[0m\n' "$issues" "$skipped"
  fi
  exit 0
}

# The standard sourceable-script idiom: (return 0 2>/dev/null) only succeeds when this
# file is being sourced, not executed. Sourcing (what tests do) defines every function
# and stops there; running it for real (the shebang path) falls through to main "$@".
if ! (return 0 2>/dev/null); then
  main "$@"
fi
