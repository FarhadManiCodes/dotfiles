#!/usr/bin/env bash
# sioyek-papis: upsert a reference from a sioyek text selection into papis.
#
# sioyek calls this as `sioyek-papis --file %{file_path} %{selected_text}`. The
# selection may be a DOI (full, partial, or broken across PDF line breaks), an
# in-text marker, a title, or a messy citation string. Behaviour:
#   * DOI found in the selection
#       - already in the papis library  -> open it in a new sioyek window
#       - not in the library            -> papis add --from doi (+ notify)
#   * no DOI, and refinery's <pdf-stem>.citations.json sits beside the PDF
#       - a marker ([10], [3,5], [6-10], (Zhou et al., 2023)) names references;
#         one is taken directly, several are offered with their printed label
#       - a reference with a DOI        -> open it if in the library, else papis add
#       - a reference without one       -> title in the library, else the search below
#   * no DOI (title / citation text)
#       - found locally by text         -> open it
#       - an arXiv id                   -> open it if in the library, else papis add
#       - otherwise                     -> Crossref search (OpenAlex if Crossref has
#                                          nothing), pick in fuzzel, upsert
#
# Notes baked in from the sioyek config quirks:
#   - sioyek splits the command on whitespace BEFORE expanding %{...}, so the
#     selection arrives as one argv, spaces and newlines included, with no shell
#     in between. "$*" also takes it split across argv, as when run by hand.
#   - library lookups read the entries' OWN fields straight from info.yaml with yq
#     (fast, no papis startup); matching the doi FIELD (not the `citations:` list)
#     avoids false matches on papers that merely cite the target.

set -uo pipefail
shopt -s extglob

PAPERS="$HOME/.local/share/papis/papers"
OPENALEX_ENV="$HOME/.config/paper-refinery/secrets/openalex.env"
note() { notify-send "papis" "$1"; }

# --file PATH names the open PDF; by hand there is none and only the text is used.
CITES=
if [[ ${1:-} == --file && $# -ge 2 ]]; then
    [[ $2 == *.pdf ]] && CITES="${2%.pdf}.citations.json"
    shift 2
fi

# --- reassemble + normalise the selection ----------------------------------
RAW="$*"
NOSPACE=${RAW//[[:space:]]/}                                      # for DOI rejoin
QUERY=${RAW//[[:space:]]/ }; QUERY=${QUERY//+( )/ }
QUERY=${QUERY# }; QUERY=${QUERY% }                                # for text search
[[ -z "$QUERY" ]] && { note "Empty selection"; exit 0; }

# One yq pass over the library, computed once and reused by every lookup:
# "doi \t eprint \t ref \t title \t file" per entry. file is the first document papis
# records under `files:`; the folder also holds refinery outputs and
# embeddings, so a directory listing can't tell which one it is.
# yq stops at the first unreadable info.yaml, and a partial list would make
# the papers after it look absent, so a failure is reported instead.
ENTRIES=$(yq -o=tsv '[(.doi // ""), (.eprint // ""), .ref, (.title // ""),
                      (filename | sub("info\.yaml$"; "")) + .files[0]]' \
            "$PAPERS"/*/info.yaml 2>&1) \
    || { note "Library scan failed: ${ENTRIES##*$'\n'}"; exit 1; }

# Entries whose field COL contains SEL, case-insensitive; the title (col 4) is
# compared on a normalised form (non-alnum -> space) so "physics informed"
# matches "Physics-informed ...". A third argument asks for equality, not
# containment. Emits "file \t ref | title". ENVIRON avoids awk -v escape
# processing of SEL.
lookup() {
    COL=$1 SEL=$2 EXACT=${3:-} awk -F'\t' '
        function norm(s) {
            s = tolower(s)
            if (col == 4) { gsub(/[^a-z0-9]+/, " ", s); gsub(/^ +| +$/, "", s) }
            return s
        }
        BEGIN { col = ENVIRON["COL"]; q = norm(ENVIRON["SEL"]) }
        q != "" && $col != "" && (ENVIRON["EXACT"] != "" ? norm($col) == q : index(norm($col), q)) \
            { print $5 "\t" $3 " | " $4 }' <<<"$ENTRIES"
}

# Open an entry's file in a new sioyek window. Without `files:` the scan yields
# just the folder, so a missing file and a missing record read the same.
open_file() {
    if [[ -f "$1" ]]; then
        sioyek --new-window "$1" >/dev/null 2>&1 &
    else
        note "Entry is in the library but has no attached file"
    fi
}

# fuzzel menu over "value \t label" lines on stdin: shows the labels, prints the
# chosen value (nothing if cancelled).
pick() { fuzzel --dmenu --only-match --with-nth=2 --accept-nth=1 --prompt "papis> "; }

# Open one match directly; offer several in a menu.
open_matches() {
    local file
    if (( $# == 1 )); then file=${1%%$'\t'*}
    else file=$(printf '%s\n' "$@" | pick) || return 0
    fi
    [[ -n "$file" ]] && open_file "$file"
}

# DOI looks complete enough to add (not a bare publisher prefix).
doi_complete() { [[ "$1" =~ ^10\.[0-9]{4,9}/.{3,}$ ]]; }

# papis add --from SOURCE ID. --batch refuses a duplicate it finds on a key this
# script doesn't look up (isbn, url, ...) but still exits 0, so check its warning.
add() {
    local out
    if ! out=$(papis add --from "$1" "$2" --no-edit --batch 2>&1); then
        note "papis add failed: ${out##*$'\n'}"; return 1
    elif [[ $out == *'No new document is created'* ]]; then
        note "Already in papis, not added: $2"
    else
        note "Added to papis: $2"
    fi
}

# Open the library entry holding DOI, else add it.
open_or_add_doi() {
    local M
    mapfile -t M < <(lookup 1 "$1" exact)
    if (( ${#M[@]} )); then open_file "${M[0]%%$'\t'*}"; else add doi "$1"; fi
}

# ---- refinery's citations.json ---------------------------------------------
# The selection names references: a marker exactly as printed, bare numbers
# ([3,5], [6-10], (3)), or author-year text ("Zhou et al., 2023"; one or several
# pieces split on ;). Markers' refs are 0-based indexes into references[]. Prints
# one US-separated line per reference: index, label as printed, doi, title,
# first author's surname, year. US rather than tab, which read would collapse
# around an empty doi.
read -r -d '' CITE_JQ <<'JQ'
def flat: gsub("\\s+"; "") | ascii_downcase | gsub("[‐-―−]"; "-");
def words: ascii_downcase | gsub("[^\\p{L}\\p{N}]+"; " ") | sub("^ +"; "") | sub(" +$"; "");
def clean: gsub("\\s+"; " ") | sub("^ "; "") | sub(" $"; "");
(.references // []) as $refs
| ($sel | flat) as $s
| ($s | gsub("[\\[\\]()]"; "")) as $n
| [ $sel | gsub("^[\\s(\\[]+|[\\s)\\]]+$"; "") | split(";")[]
    | capture("^\\s*(?<name>[^0-9;]*[A-Za-z][^0-9;]*?)[\\s,]*(?<year>(?:19|20)[0-9]{2})[a-z]?\\s*$")?
    | {tok: (.name | ascii_downcase | sub("( and | & |,| et al).*$"; "") | words),
       year: (.year | tonumber)}
    | select(.tok | length >= 2) ] as $pieces
| (
    [.linking.markers[]? | select((.text | flat) == $s) | .refs[]]
    | if length > 0 then .
      elif ($n | test("^[0-9]+(-[0-9]+)?([,;][0-9]+(-[0-9]+)?)*$")) then
          [ $n | splits("[,;]")
            | if test("-") then (split("-") | map(tonumber)) as [$a, $b]
                                | if $b >= $a and $b - $a < 60 then range($a; $b + 1) else empty end
              else tonumber end | tostring ] as $nums
          | [ $refs | to_entries[]
              | select(.value.number != null and (.value.number | tostring | IN($nums[]))) | .key ]
      else
          [ $refs | to_entries[] | . as $e
            | select(any($pieces[]; . as $p
                | ($e.value.authors[0].family // "" | words) as $f
                | $e.value.year == $p.year and $f != ""
                  # whole words only: "van der Berg" matches "Berg" and back, "Li" not "Ali"
                  and ((" " + $p.tok) | endswith(" " + $f) or . == (" " + $f) or ((" " + $f) | endswith(" " + $p.tok))))) | .key ]
      end
  )
| unique[] | . as $i | $refs[$i] | select(. != null)
| ((.citation_key // (if .number then "[\(.number)]" else null end)) as $k
   | ([$k, "\(.authors[0].family // "?") \(.year // "?")"] | map(select(. != null)) | join(" "))
     + " — " + (.title // "?" | clean)) as $label
| [($i | tostring), $label, (.doi // ""), (.title // "" | clean),
   (.authors[0].family // ""), (.year // "" | tostring)] | join("\u001f")
JQ

US=$'\x1f'

# Library entries for a reference: by DOI, else by exact title, since the library
# may hold the preprint of a paper the reference cites under its published DOI.
find_reference() {
    local m=
    [[ -n $1 ]] && m=$(lookup 1 "$1" exact)
    [[ -n $m ]] || m=$(lookup 4 "$2" exact)
    [[ -z $m ]] || printf '%s\n' "$m"
}

# Take the one reference, or let fuzzel choose among several (marked when already
# in the library), then resolve it: the library entry, else add its DOI, else an
# external search by title, first author and year.
resolve_reference() {
    local line idx label doi title surname year menu=() chosen
    if (( $# == 1 )); then chosen=$1
    else
        for line; do
            IFS=$US read -r idx label doi title _ <<<"$line"
            [[ -n $(find_reference "$doi" "$title") ]] && label+="  ✓"
            menu+=("$idx"$'\t'"$label")
        done
        idx=$(printf '%s\n' "${menu[@]}" | pick) || return 0
        [[ -n "$idx" ]] || return 0
        for line; do [[ ${line%%"$US"*} == "$idx" ]] && chosen=$line; done
    fi
    IFS=$US read -r _ _ doi title surname year <<<"$chosen"
    local M
    mapfile -t M < <(find_reference "$doi" "$title")
    if (( ${#M[@]} )); then open_matches "${M[@]}"
    elif [[ -n $doi ]]; then add doi "$doi"
    else external_search "$title $surname $year"
    fi
}

# ---- external title search -------------------------------------------------
# Both providers print "doi \t label" menu lines for pick. Crossref needs no key;
# on failure it prints curl's message and returns 1.
crossref() {
    local json
    json=$(curl -sSfG -m 10 --data-urlencode "query.bibliographic=$1" \
        -d rows=8 -d select=DOI,title,issued https://api.crossref.org/works 2>&1) \
        || { printf '%s' "${json##*$'\n'}"; return 1; }
    # Titles can hold newlines and tabs, which would break the menu's lines and columns.
    printf '%s' "$json" | jq -r '
        .message.items[]?
        | "\(.DOI)\t\(.title[0] // "?" | gsub("\\s+"; " ")) — \(.issued."date-parts"[0][0] // "?") — \(.DOI)"' 2>/dev/null
}

# The backup: OpenAlex's key is paid and shared with refinery's batches, so it is
# asked only when Crossref found nothing. Returns 1 without a key or when the
# request fails, so the caller reports Crossref's outcome. The key reaches curl
# on stdin, not in its arguments, where ps would show it.
openalex() {
    local key json
    # shellcheck source=/dev/null  # outside the repo
    key=$( . "$OPENALEX_ENV" 2>/dev/null && printf %s "${OPENALEX_API_KEY:-}" )
    [[ -n $key ]] || return 1
    json=$(printf 'Authorization: Bearer %s\n' "$key" | curl -sSfG -m 10 -H @- \
        --data-urlencode "search=$1" -d per-page=8 -d select=doi,title,publication_year \
        https://api.openalex.org/works 2>/dev/null) || return 1
    printf '%s' "$json" | jq -r '
        .results[]? | select(.doi) | (.doi | sub("^https?://doi.org/"; "")) as $d
        | "\($d)\t\(.title // "?" | gsub("\\s+"; " ")) — \(.publication_year // "?") — \($d)"' 2>/dev/null
}

# Resolve free text to a DOI: Crossref, then OpenAlex, pick in fuzzel, upsert.
external_search() {
    local out err="" results=() oa_asked=""
    out=$(crossref "$1") || { err=$out; out=; }
    mapfile -t results < <(printf '%s' "$out")
    if (( ! ${#results[@]} )); then
        if out=$(openalex "$1"); then oa_asked=" or OpenAlex"; fi
        mapfile -t results < <(printf '%s' "$out")
    fi
    if (( ! ${#results[@]} )); then
        [[ -n $err ]] && { note "Crossref request failed: $err"; exit 1; }
        note "No Crossref${oa_asked} match for: $1"; exit 0
    fi
    local picked
    picked=$(printf '%s\n' "${results[@]}" | pick) || exit 0
    [[ -n "$picked" ]] && open_or_add_doi "$picked"
    exit 0
}

# =====================  main  ==============================================
# DOI, trailing punctuation stripped. A bare publisher prefix ("10.1103/") is not
# looked up, so it doesn't list every paper from that publisher.
if [[ $NOSPACE =~ 10\.[0-9]{4,9}/.* ]]; then
    DOI=${BASH_REMATCH[0]%%+([.,;:)])}
    M=(); [[ $DOI == */ ]] || mapfile -t M < <(lookup 1 "$DOI")
    if (( ${#M[@]} )); then open_matches "${M[@]}"
    elif doi_complete "$DOI"; then add doi "$DOI"
    else note "Incomplete DOI; select the full DOI"
    fi
    exit 0
fi

# ---- a marker or author-year citation, through this paper's citations.json --
if [[ -f $CITES ]]; then
    mapfile -t REFS < <(jq -r --arg sel "$QUERY" "$CITE_JQ" "$CITES" 2>/dev/null)
    (( ${#REFS[@]} )) && { resolve_reference "${REFS[@]}"; exit 0; }
fi

# ---- no DOI: local bibliographic search (normalised title match) ----------
mapfile -t M < <(lookup 4 "$QUERY")
(( ${#M[@]} )) && { open_matches "${M[@]}"; exit 0; }

# ---- arXiv id (no DOI, looks like an arXiv id) ----------------------------
if [[ $NOSPACE =~ [0-9]{4}\.[0-9]{4,5}(v[0-9]+)? ]]; then
    ARXIV=${BASH_REMATCH[0]}
    mapfile -t M < <(lookup 2 "${ARXIV%v*}")          # the library may hold another version
    (( ${#M[@]} )) && { open_matches "${M[@]}"; exit 0; }
    add arxiv "$ARXIV" && exit 0
    # else fall through to the text search
fi

external_search "$QUERY"
