#!/bin/bash
# Status check menu — fuzzel dmenu, each selection fires a notification.

BAT_FULL=$''
BAT_THREE=$''
BAT_HALF=$''
BAT_QUARTER=$''
BAT_EMPTY=$''
BOLT=$'⚡'
CLOCK=$''
THERM=$''
CHIP=$''

WORLD=$(printf '\U000f01e7')
NET=$(printf '\U000f059f')    # nf-md-web (globe)
WIFI=$(printf '\U000f05a9')   # nf-md-wifi
ETH=$(printf '\U000f0200')    # nf-md-ethernet
choice=$(printf '%s Battery\n%s Internet\n%s Uptime\n%s CPU Temp\n%s Memory\n%s Time' \
    "$BAT_FULL" "$NET" "$CLOCK" "$THERM" "$CHIP" "$WORLD" \
    | fuzzel --dmenu --prompt "Status: " --width 30 --lines 6)
[[ -z "$choice" ]] && exit 0

case "$choice" in
    *Battery*)
        # power-notify's rules, so the two agree: percent from energy, rounded down;
        # "~N min" under an hour, else whole hours; charging stops at TLP's limit.
        b=/sys/class/power_supply/BAT0
        status=$(<"$b/status") e=$(<"$b/energy_now") full=$(<"$b/energy_full")
        w=$(<"$b/power_now") limit=$(<"$b/charge_control_end_threshold")
        (( full > 0 )) || { notify-send "${BAT_EMPTY} Battery" "Charge not readable"; exit 0; }
        cap=$(( e * 100 / full ))
        if (( cap >= 80 )); then icon=$BAT_FULL
        elif (( cap >= 60 )); then icon=$BAT_THREE
        elif (( cap >= 40 )); then icon=$BAT_HALF
        elif (( cap >= 20 )); then icon=$BAT_QUARTER
        else icon=$BAT_EMPTY
        fi
        case $status in
            Charging) icon=$BOLT; togo=$(( full * ${limit:-100} / 100 - e )); what=" to ${limit:-100}%" ;;
            Discharging) togo=$e what=" left" ;;
            *) togo=0 ;;
        esac
        body="${cap}% — ${status}"
        if (( w > 0 && togo > 0 )); then
            m=$(( togo * 60 / w ))
            (( m < 60 )) && t="$m min" || t="$(( (m + 30) / 60 )) h"
            body+=", ~${t}${what}"
        fi
        notify-send -u low "${icon} Battery" "$body"
        ;;
    *Internet*)
        # Connection + negotiated link speed (instant, no traffic). Lines kept short so
        # they don't wrap in mako's fixed-width box; "(active)" = the default-route iface.
        default_if=$(ip route show default 2>/dev/null | awk '/^default/{print $5; exit}')
        body=""
        for p in /sys/class/net/*; do
            ifc=$(basename "$p")
            [[ "$ifc" == lo ]] && continue
            mark=""; [[ "$ifc" == "$default_if" ]] && mark="  (active)"
            if [[ -e "$p/phy80211" ]]; then
                link=$(iw dev "$ifc" link 2>/dev/null)
                grep -q "Connected to" <<<"$link" || continue
                ssid=$(grep -m1 'SSID:'       <<<"$link" | sed 's/^[[:space:]]*SSID: //')
                rxbr=$(grep -m1 'rx bitrate:' <<<"$link" | awk '{printf "%.0f",$3}')
                body+="${WIFI}  ${ssid} · ${rxbr} Mb/s${mark}\n"
            elif [[ -e "$p/device" ]]; then
                [[ "$(cat "$p/carrier" 2>/dev/null)" == "1" ]] || continue
                spd=$(cat "$p/speed" 2>/dev/null)
                body+="${ETH}  ${spd} Mb/s${mark}\n"
            fi
        done
        if [[ -z "$body" ]]; then
            notify-send -u normal "${NET} Internet" "Offline — no active connection"
        else
            notify-send -u low "${NET} Internet" "${body%\\n}"
        fi
        ;;
    *Uptime*)
        load=$(awk '{printf "%s  %s  %s", $1, $2, $3}' /proc/loadavg)
        notify-send -u low "${CLOCK} Uptime" "$(uptime -p)\nLoad (1/5/15 min): ${load}"
        ;;
    *"CPU Temp"*)
        # First match of each; values compared with "" since a fan can read 0.
        body=$(sensors 2>/dev/null | awk '
            /Tctl/    && cpu == "" { cpu = $2 }
            /^edge:/  && gpu == "" { gpu = $2 }
            /^fan1:/  && f1 == ""  { f1 = $2 }
            /^fan2:/  && f2 == ""  { f2 = $2 }
            END {
                gsub(/[+°C]/, "", cpu); gsub(/[+°C]/, "", gpu)
                s = cpu != "" ? "CPU " cpu "°C" : ""
                if (gpu != "") s = s " • GPU " gpu "°C"
                if (f1 != "")  s = s " • Fan " f1 (f2 != "" ? "/" f2 : "") " RPM"
                print s
            }')
        notify-send -u low "${THERM} CPU Temp" "$body"
        ;;
    *Memory*)
        # "none" only when there is no swap at all: unused swap reads "0B used".
        body=$(free -h | awk '
            /^Mem/  { print $3 " used / " $2 " total (" $7 " avail)" }
            /^Swap/ { print ($2 == "0B" ? "Swap: none" : "Swap: " $3 " used / " $2) }')
        notify-send -u low "${CHIP} Memory" "$body"
        ;;
    *Time*)
        # Local + Iran + Vancouver(=Seattle, Pacific); Germany only when not local.
        local_tz=$(timedatectl show -p Timezone --value 2>/dev/null)
        body="Local      $(date '+%a %H:%M %Z')"
        [[ "$local_tz" != "Europe/Berlin" ]] && body+="\nGermany    $(TZ=Europe/Berlin date '+%a %H:%M')"
        body+="\nIran       $(TZ=Asia/Tehran date '+%a %H:%M')"
        body+="\nVancouver  $(TZ=America/Vancouver date '+%a %H:%M')"
        notify-send -u low "${WORLD} World Clock" "$body"
        ;;
esac
