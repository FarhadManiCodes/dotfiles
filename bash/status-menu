#!/bin/bash
# Status check menu — fuzzel dmenu, each selection fires a notification.

BAT_FULL=$''
BAT_THREE=$''
BAT_HALF=$''
BAT_QUARTER=$''
BAT_EMPTY=$''
BOLT=$'⚡'
CLOCK=$''
THERM=$''
CHIP=$''
OPENAI=$'\uec81' # nf-cod-openai
CLAUDE=$'\uec82' # nf-cod-claude

WORLD=$(printf '\U000f01e7')
NET=$(printf '\U000f059f')  # nf-md-web (globe)
WIFI=$(printf '\U000f05a9') # nf-md-wifi
ETH=$(printf '\U000f0200')  # nf-md-ethernet
choice=$(printf '%s Battery\n%s Internet\n%s Uptime\n%s Temperatures\n%s Memory\n%s Time\n%s Codex\n%s Claude' \
  "$BAT_FULL" "$NET" "$CLOCK" "$THERM" "$CHIP" "$WORLD" "$OPENAI" "$CLAUDE" \
  | fuzzel --dmenu --prompt "Status: " --width 30 --lines 8)
[[ -n "$choice" ]] || exit 0

case "$choice" in
  *Battery*)
    # power-notify's rules, so the two agree: percent from energy, rounded down;
    # "~N min" under an hour, else whole hours; charging stops at TLP's limit.
    b=/sys/class/power_supply/BAT0
    status=$(<"$b/status") e=$(<"$b/energy_now") full=$(<"$b/energy_full")
    w=$(<"$b/power_now") limit=$(<"$b/charge_control_end_threshold")
    if [[ -z $e ]] || ((full <= 0)); then # the controller can time out
      notify-send "${BAT_EMPTY} Battery" "Charge not readable"
      exit 0
    fi
    cap=$((e * 100 / full))
    # Five icons, one per 20%; 80% and up, over 100% too, is full.
    icons=("$BAT_EMPTY" "$BAT_QUARTER" "$BAT_HALF" "$BAT_THREE" "$BAT_FULL")
    i=$((cap / 20))
    ((i > 4)) && i=4
    icon=${icons[i]}
    case $status in
      Charging)
        icon=$BOLT
        togo=$((full * ${limit:-100} / 100 - e))
        what=" to ${limit:-100}%"
        ;;
      Discharging) togo=$e what=" left" ;;
      *) togo=0 ;;
    esac
    body="${cap}% — ${status}"
    # Under 1 W is a reading not yet settled, as just after resume (0.2 W: "~109 h").
    if ((w >= 1000000)); then
      body+=" at $(((w + 500000) / 1000000)) W"
    fi
    if ((w >= 1000000 && togo > 0)); then
      m=$((togo * 60 / w))
      if ((m < 60)); then
        t="$m min"
      else
        t="$(((m + 30) / 60)) h"
      fi
      body+=", ~${t}${what}"
    fi
    # What a charger offers: its best fixed USB-C PD profile, volts × amps. Not the
    # UCSI power_supply's voltage_max × current_max, which mixes profiles (60 W for 27).
    for port in /sys/class/typec/port*-partner; do
      [[ -e $port ]] || continue
      read -r role <"${port%-partner}/power_role" || continue
      [[ $role == *'[sink]'* ]] || continue
      best=0
      for pdo in "$port"/usb_power_delivery/source-capabilities/*:fixed_supply; do
        [[ -e $pdo ]] || continue
        v=$(<"$pdo/voltage") a=$(<"$pdo/maximum_current")
        watts=$((${v%mV} * ${a%mA} / 1000000))
        ((watts > best)) && best=$watts
      done
      if ((best > 0)); then
        body+=" · charger $best W"
      else
        body+=" · charger without USB PD"
      fi
    done
    notify-send -u low "${icon} Battery" "$body"
    ;;
  *Internet*)
    # Connection + negotiated link speed (instant, no traffic). Lines kept short so
    # they don't wrap in mako's fixed-width box; "(active)" = the default-route iface.
    route=$(ip -j route show default 2>/dev/null) && default_if=$(jq -r '.[0].dev // empty' <<<"$route")
    body=""
    for p in "${NET_SYSFS:-/sys/class/net}"/*; do
      ifc=${p##*/}
      [[ "$ifc" == lo ]] && continue
      mark=""
      [[ "$ifc" == "$default_if" ]] && mark="  (active)"
      if [[ -e "$p/phy80211" ]]; then
        link=$(iw dev "$ifc" link 2>/dev/null)
        [[ $link == *'Connected to'* ]] || continue
        ssid='' rxbr=''
        while IFS=: read -r key value; do
          case $key in
            *SSID) ssid=${value# } ;;
            *'rx bitrate')
              # iw prints tenths ("866.7 MBit/s"), rounded here to whole Mb/s.
              read -r rxbr _ <<<"$value"
              if [[ $rxbr =~ ^([0-9]+)\.([0-9])$ ]]; then
                rxbr=$((BASH_REMATCH[1] + (BASH_REMATCH[2] >= 5)))
              fi
              ;;
          esac
        done <<<"$link"
        # Signal as a word. The driver's average is steadier than the last frame's
        # reading, which link prints. -67 dBm is the usual floor for reliable calls;
        # above it, three equal steps in dB (each faster rate needs a few dB more).
        # In impala's percentage, 2 x (100 + dBm): excellent from 90%, very good
        # from 78%, good from 66%, fair from 50%, weak from 30%.
        # Details go on their own line: with the signal they no longer fit beside the SSID.
        dump=$(iw dev "$ifc" station dump 2>/dev/null) || dump=''
        sig=$(awk '/^\tsignal:/ && last == "" {last = $2} /^\tsignal avg:/ && avg == "" {avg = $3} END {
          if (avg == "" && last == "") exit
          d = (avg != "" ? avg : last) + 0
          q = d >= -55 ? "excellent" : d >= -61 ? "very good" : d >= -67 ? "good" \
            : d >= -75 ? "fair" : d >= -85 ? "weak" : "very weak"
          print " · " q " signal"
        }' <<<"$link"$'\n'"$dump")
        body+="${WIFI}  ${ssid}${mark}\n     ${rxbr} Mb/s${sig}\n"
      elif [[ -e "$p/device" ]]; then
        read -r carrier 2>/dev/null <"$p/carrier" || continue
        [[ $carrier == 1 ]] || continue
        read -r spd 2>/dev/null <"$p/speed" || spd=''
        body+="${ETH}  ${spd} Mb/s${mark}\n"
      fi
    done
    if [[ -z "$body" ]]; then
      notify-send -u normal "${NET} Internet" "Offline — no active connection"
    else
      notify-send -u low "${NET} Internet" "${body%\\n}"
    fi
    ;;
  *Uptime*)
    read -r l1 l5 l15 _ </proc/loadavg
    up=$(uptime -p) || up='Uptime unknown'
    notify-send -u low "${CLOCK} Uptime" "${up}\nLoad (1/5/15 min): ${l1}  ${l5}  ${l15}"
    ;;
  *Temperatures*)
    sensor_warning=""
    if ! readings=$(hardware-readings); then
      sensor_warning=$'\nSensor readings unavailable'
    fi
    IFS=$'\t' read -r cpu gpu ssd fan1 fan2 <<<"${readings:-$'N/A\tN/A\tN/A\tN/A\tN/A'}"
    printf -v body 'CPU %s • GPU %s • SSD %s\nFan 1 %s • Fan 2 %s%s' \
      "$cpu" "$gpu" "$ssd" "$fan1" "$fan2" "$sensor_warning"
    notify-send -u low "${THERM} Temperatures" "$body"
    ;;
  *Memory*)
    # "none" only when there is no swap at all: unused swap reads "0B used".
    mem=$(free -h) || mem=''
    body=$(awk '
            /^Mem/  { print $3 " used / " $2 " total (" $7 " avail)" }
            /^Swap/ { print ($2 == "0B" ? "Swap: none" : "Swap: " $3 " used / " $2) }' <<<"$mem")
    notify-send -u low "${CHIP} Memory" "${body:-Memory not readable}"
    ;;
  *Time*)
    # Local + Iran + Vancouver(=Seattle, Pacific); Germany only when not local.
    local_tz=$(timedatectl show -p Timezone --value 2>/dev/null)
    body="Local      $(date '+%a %H:%M %Z')"
    [[ "$local_tz" != "Europe/Berlin" ]] && body+="\nGermany    $(TZ=Europe/Berlin date '+%a %H:%M')"
    body+="\nIran       $(TZ=Asia/Tehran date '+%a %H:%M')"
    body+="\nVancouver  $(TZ=America/Vancouver date '+%a %H:%M')"
    notify-send -u low "${WORLD} World Clock" "$body"
    ;;
  *Codex*)
    body=$(codex-limits 2>/dev/null)
    notify-send -u low "${OPENAI} Codex limits" "${body:-Codex did not answer}"
    ;;
  *Claude*)
    # /usage is answered locally by the CLI with live numbers (~3 s); the two
    # "Current ..." lines are the limits, the rest is a breakdown.
    usage=$(timeout 20 claude -p /usage 2>/dev/null)
    body=$(grep '^Current' <<<"$usage")
    notify-send -u low "${CLAUDE} Claude limits" "${body:-Claude did not answer}"
    ;;
esac
