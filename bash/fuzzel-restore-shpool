#!/usr/bin/env bash
set -uo pipefail

# Niri's spawned processes get the isolated application PATH, which deliberately
# excludes Cargo (see niri/isolated-session.md) -- only an interactive zsh adds
# it. shpool is cargo-installed, so it must be called by full path here.
shpool="$HOME/.cargo/bin/shpool"

notify_error() {
    notify-send --urgency=critical "shpool restore failed" "$1"
}

[[ -x "$shpool" ]] || { notify_error "shpool is not installed at $shpool. Recreate it with: cargo install shpool"; exit 1; }
command -v jq >/dev/null 2>&1 || { notify_error "jq is not installed, so the shpool session list cannot be read."; exit 1; }

if ! sessions_json=$("$shpool" list --json 2>&1); then
    notify_error "Could not reach shpool (${sessions_json##*$'\n'}). Check: systemctl --user status shpool.socket"
    exit 1
fi

# One line per session name; jq fails on a malformed list (no array, a
# non-string name), as it should.
if ! menu=$(jq -r '.sessions[] | .name + ""' <<<"$sessions_json"); then
    notify_error "shpool returned an invalid session list."
    exit 1
fi
[[ -n "$menu" ]] || { notify-send "shpool" "No background sessions running."; exit 0; }

selected=$(fuzzel --dmenu --prompt="Restore Task > " <<<"$menu")
[[ -n "$selected" ]] || exit 0
exec footclient --app-id=foot-popup "$shpool" attach "$selected"
