#!/bin/bash
# Jump to the END of a sioyek text selection in the running Neovim, via SyncTeX.
#
# Sioyek calls this with:   sioyek-to-source %{file_path} %{selection_end_document}
#   $1 = absolute path to the PDF
#   $2 = "page x y", one argv: sioyek splits the command on whitespace BEFORE
#        expanding %{...}, so it is re-split here. Without a selection sioyek
#        leaves the token literal, the page isn't numeric, and this exits quietly.
# The page is 0-based from sioyek; `synctex edit` is 1-based.
#
# Coordinates beat searching for the selected text: sioyek's own inverse search
# feeds this same {page,x,y} to synctex_edit_query, so the units match exactly,
# and it survives math and macros where a literal text search breaks.

pdf=$1
read -r page x y <<<"${2:-}"
[[ $page =~ ^[0-9]+$ ]] || exit 0
[[ -f $pdf ]] || { notify-send sioyek "No PDF path"; exit 1; }

# A PDF built without -synctex=1 fails here, with the reason on the first line.
out=$(synctex edit -o "$((page + 1)):$x:$y:$pdf" 2>&1) \
    || { notify-send sioyek "synctex: ${out%%$'\n'*}"; exit 1; }

# The first result: each block lists Input: before Line:.
file='' line=''
while IFS=: read -r key val; do
    case $key in
        Input) file=$val ;;
        Line) line=$val; break ;;
    esac
done <<<"$out"
[[ -n $file && -n $line ]] \
    || { notify-send sioyek "SyncTeX found no source for this selection"; exit 1; }

# synctex prints /dir/./main.tex; normalise so nvim matches the open buffer
# instead of opening a duplicate.
file=$(realpath -m -- "$file")

# vimtex's inverse search, as sioyek's own inverse_search_command does: it
# finds the nvim that has the file open through vimtex's server registry, and
# its VimtexEventViewReverse autocmd focuses that foot window.
exec nvim --headless -c "VimtexInverseSearch $line '$file'"
