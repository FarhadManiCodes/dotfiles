#!/usr/bin/env bash
# Unified fzf picker helper for vifm commands.
# Usage: vifm-pick <fbook|rgbook|fdata|fnb>
#
# vifm cannot read a function's output, so the choice comes back through
# $XDG_RUNTIME_DIR/vifm-pick/{action,path}. Only navigation crosses back:
# opening and copying happen HERE, with real argument lists, so vifm never
# builds a shell command out of a filename. A filename may contain any byte
# except / and NUL, and vifm's :!  commands are plain strings.
#
# MIRRORS the interactive shell finders — keep the search halves in sync:
#   fbook, rgbook  <-> zsh/functions/pdf.zsh
#   fdata, fnb     <-> zsh/functions/fzf.zsh
# Identical in both: the rg command, the rg preview and the fdata extension
# list; the awk formatter is one file both read, vifm-pick.d/rgbook.awk. Only
# the fzf key handling and what happens to the selection differ, and
# deliberately so: the zsh versions `cd`, which only works in the interactive
# shell, while vifm needs the exchange files below.
#
# fzf substitutes {} and {1} as a SINGLE-QUOTED string, so they must sit outside
# any quotes of ours. "$SP/"{} concatenates correctly; "$SP/{}" does not and
# lets a backtick in a filename run during preview, before any key is pressed.

# shellcheck disable=SC2016
# Single quotes are deliberate in the --preview strings: $SP must reach fzf's
# own preview shell unexpanded, and {} / {1} are fzf placeholders, not shell.

set -u

cmd="${1:-}"
xdir="${XDG_RUNTIME_DIR:?}/vifm-pick"
mkdir -p "$xdir"
chmod 700 "$xdir"
rm -f "$xdir"/action "$xdir"/path "$xdir"/cd "$xdir"/cp

# reply <cd|goto|none> [path] — the only things vifm still acts on.
reply() {
  printf '%s' "$1" >"$xdir/action"
  [[ $# -ge 2 ]] && printf '%s' "$2" >"$xdir/path"
  return 0
}

# Open in sioyek directly rather than via xdg-open, because xdg-open cannot
# carry a page number (--page, the point of rgbook).
# setsid detaches the viewer from vifm's term() window, which closes on exit.
# Sioyek centers --yloc in the window. Without it, --page puts the page's top
# boundary at the center, leaving the previous page visible.

open_book() {
  local file="$1" page="${2:-}" yloc args=()
  if [[ -n "$page" ]]; then
    args=(--page "$page")
    yloc=$(pdf-meta yloc "$file" "$page" 2>/dev/null)
    [[ -n "$yloc" ]] && args+=(--yloc "$yloc")
  fi
  setsid -f sioyek "${args[@]}" "$file" >/dev/null 2>&1
}

case "$cmd" in

  fbook)
    sp="${PAPIS_PAPERS:-$HOME/.local/share/papis/papers}"
    export SP="$sp"
    result=$(fd --type f --max-depth 2 -e pdf -e epub . "$sp" 2>/dev/null \
      | sed "s|^$sp/||" \
      | fzf \
        --bind "ctrl-d:execute-silent(touch '$xdir/cd')+accept" \
        --preview 'pdf-meta preview "$SP/"{} 2>/dev/null || echo "No info available"' \
        --preview-window=hidden,right:40% \
        --bind 'ctrl-p:toggle-preview' \
        --header='Enter: open | Ctrl-d: cd')
    [[ -z "$result" ]] && exit 0
    abs="$sp/$result"
    if [[ -e "$xdir/cd" ]]; then
      reply cd "$(dirname "$abs")"
    else
      reply none
      open_book "$abs"
    fi
    ;;

  rgbook)
    sp="${PAPIS_PAPERS:-$HOME/.local/share/papis/papers}"
    export SP="$sp"
    rg_cmd="[ -n {q} ] && rg --smart-case --color=always --no-heading --line-number --max-depth 2 -g '*.md' -g '!notes.md' -g '!*.refinery/**' -e '^<page_number>[0-9]+</page_number>$' -e {q} \"\$SP\" 2>/dev/null"
    # Exported, like SP, for fzf's reload shell; shared with rgbook in zsh.
    RGBOOK_AWK="$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")/vifm-pick.d/rgbook.awk"
    export RGBOOK_AWK
    format_cmd="awk -v sp=\"\$SP/\" -f \"\$RGBOOK_AWK\""
    reload_cmd="$rg_cmd | $format_cmd || true"
    result=$(fzf --ansi --disabled \
      --bind "change:reload:$reload_cmd" \
      --bind "start:reload:$reload_cmd" \
      --delimiter=$'\t' \
      --with-nth=2 \
      --bind "ctrl-d:execute-silent(touch '$xdir/cd')+accept" \
      --preview '[ -n {q} ] && rg --smart-case --context 3 --no-heading -e {q} "$SP/"{1} 2>/dev/null | head -20' \
      --preview-window='hidden,right:50%' \
      --bind 'ctrl-p:toggle-preview' \
      --header='Enter: open at page | Ctrl-d: cd')
    [[ -z "$result" ]] && exit 0
    relpath="${result%%$'\t'*}"
    page=$(grep -oP 'Page \K[0-9]+' <<<"$result" | head -1)
    abs="$sp/${relpath%.md}.pdf"
    # vifm redraws over term()'s output, so stderr would never be seen.
    if [[ ! -f "$abs" ]]; then
      notify-send rgbook "File not found: $abs"
      exit 1
    fi
    if [[ -e "$xdir/cd" ]]; then
      reply cd "$(dirname "$abs")"
    else
      reply none
      open_book "$abs" "$page"
    fi
    ;;

  fdata)
    exts=(csv tsv jsonl ndjson json yaml yml parquet avro orc feather
      xlsx xls pkl pickle joblib h5 hdf5 pt pth onnx)
    # git/ignore hides data formats such as *.parquet everywhere; fd finds it
    # through XDG_CONFIG_HOME, so pointing that away shows them. Its directory
    # rules go too (build/, _build/, build_*/, bin/, ENV/, /target/,
    # /dbt_packages/, /logs/), so data files in them show; each repository's
    # .gitignore still applies.
    fd_cmd=(env XDG_CONFIG_HOME=/nonexistent
      fd --one-file-system --type f "${exts[@]/#/--extension=}"
      --exclude __pycache__ --exclude node_modules --exclude venv)
    result=$("${fd_cmd[@]}" 2>/dev/null | fzf \
      --bind "ctrl-d:execute-silent(touch '$xdir/cd')+accept" \
      --bind "ctrl-v:execute-silent(touch '$xdir/cp')+accept" \
      --preview 'bat --color=always --style=plain --line-range=:12 {} 2>/dev/null' \
      --preview-window=hidden,right:40% \
      --bind 'ctrl-p:toggle-preview' \
      --header='Enter: goto | Ctrl-d: cd | Ctrl-v: copy path')
    [[ -z "$result" ]] && exit 0
    abs=$(realpath "$result" 2>/dev/null || printf '%s' "$result")
    if [[ -e "$xdir/cd" ]]; then
      reply cd "$(dirname "$abs")"
    elif [[ -e "$xdir/cp" ]]; then
      reply none
      printf '%s' "$abs" | setsid -f wl-copy
    else
      reply goto "$abs"
    fi
    ;;

  fnb)
    result=$(fd --one-file-system --type f --extension ipynb 2>/dev/null \
      | fzf \
        --bind "ctrl-d:execute-silent(touch '$xdir/cd')+accept" \
        --preview 'echo "Cells: $(jq ".cells | length" {} 2>/dev/null || echo unknown)"' \
        --preview-window=hidden,right:30% \
        --bind 'ctrl-p:toggle-preview' \
        --header='Enter: goto | Ctrl-d: cd')
    [[ -z "$result" ]] && exit 0
    abs=$(realpath "$result" 2>/dev/null || printf '%s' "$result")
    if [[ -e "$xdir/cd" ]]; then
      reply cd "$(dirname "$abs")"
    else
      reply goto "$abs"
    fi
    ;;

  *)
    echo "vifm-pick: unknown command '${cmd}'" >&2
    exit 1
    ;;
esac

rm -f "$xdir/cd" "$xdir/cp"
