#!/usr/bin/env bash
# Unified fzf picker helper for vifm commands.
# Usage: vifm-pick <fbook|rgbook|fdata|fnb>
#
# vifm cannot read a function's output, so the choice comes back through
# $XDG_RUNTIME_DIR/vifm-pick/{action,path}. Only navigation crosses back:
# opening and copying happen HERE, with real argument lists, so vifm never
# builds a shell command out of a filename. A filename may contain any byte
# except / and NUL, and vifm's :!  commands are plain strings.
#
# MIRRORS the interactive shell finders — keep the search halves in sync:
#   fbook, rgbook  <-> zsh/functions/pdf.zsh
#   fdata, fnb     <-> zsh/functions/fzf.zsh
# Identical in both: the rga command, the awk formatter, the rga preview and the
# fdata extension list. Only the fzf key handling and what happens to the
# selection differ, and deliberately so: the zsh versions `cd`, which only works
# in the interactive shell, while vifm needs the exchange files below.
#
# fzf substitutes {} and {1} as a SINGLE-QUOTED string, so they must sit outside
# any quotes of ours. "$SP/"{} concatenates correctly; "$SP/{}" does not and
# lets a backtick in a filename run during preview, before any key is pressed.

# shellcheck disable=SC2016
# Single quotes are deliberate in the --preview strings: $SP must reach fzf's
# own preview shell unexpanded, and {} / {1} are fzf placeholders, not shell.

set -u

cmd="${1:-}"
xdir="$XDG_RUNTIME_DIR/vifm-pick"
mkdir -p "$xdir"
chmod 700 "$xdir"
rm -f "$xdir"/action "$xdir"/path "$xdir"/cd "$xdir"/cp

# reply <cd|goto|none> [path] — the only things vifm still acts on.
reply() {
    printf '%s' "$1" > "$xdir/action"
    [[ $# -ge 2 ]] && printf '%s' "$2" > "$xdir/path"
    return 0
}

# Open by type: sioyek for PDF — it is the only one taking --page, which is the
# point of rgbook — zathura for DjVu, Foliate for EPUB. Same mapping as
# mimeapps.list, dispatched here because handlr cannot carry a page number.
# setsid detaches the viewer from vifm's term() window, which closes on exit.
open_book() {
    local file="$1" page="${2:-}"
    case "${file,,}" in
        *.pdf)
            if [[ -n "$page" ]]; then
                setsid -f sioyek --page "$page" "$file" >/dev/null 2>&1
            else
                setsid -f sioyek "$file" >/dev/null 2>&1
            fi
            ;;
        *.djvu) setsid -f zathura "$file" >/dev/null 2>&1 ;;
        *.epub) setsid -f foliate "$file" >/dev/null 2>&1 ;;
        *)      setsid -f handlr open "$file" >/dev/null 2>&1 ;;
    esac
}

case "$cmd" in

  fbook)
    sp="${STUDY_LIBRARY:-$HOME/.local/share/study-library}"
    export SP="$sp"
    result=$(fd --type f -e pdf -e epub -e djvu . "$sp" 2>/dev/null \
        | sed "s|^$sp/||" \
        | fzf \
            --bind "ctrl-d:execute-silent(touch '$xdir/cd')+accept" \
            --preview 'pdfinfo "$SP/"{} 2>/dev/null || echo "No info available"' \
            --preview-window=hidden,right:40% \
            --bind 'ctrl-p:toggle-preview' \
            --header='Enter: open | Ctrl-d: cd')
    [[ -z "$result" ]] && exit 0
    abs="$sp/$result"
    if [[ -e "$xdir/cd" ]]; then
        reply cd "$(dirname "$abs")"
    else
        reply none
        open_book "$abs"
    fi
    ;;

  rgbook)
    sp="${STUDY_LIBRARY:-$HOME/.local/share/study-library}"
    export SP="$sp"
    rga_cmd="rga -g '*.pdf' --color=always --line-number --no-heading {q} '$sp' 2>/dev/null"
    format_cmd="awk -F: -v sp='$sp/' '{
        gsub(/\\033\\[[0-9;]*m/, \"\", \$1);
        gsub(sp, \"\", \$1);
        n=split(\$1,a,\"/\");
        key=\$1\":\"\$3;
        if(seen[key]++) next;
        printf \"%s\\t%s:\\033[32m%s\\033[0m:%s\\n\", \$1, a[n], \$3, \$4
    }'"
    reload_cmd="$rga_cmd | $format_cmd || true"
    result=$(fzf --ansi --disabled \
        --bind "change:reload:$reload_cmd" \
        --bind "start:reload:$reload_cmd" \
        --delimiter=$'\t' \
        --with-nth=2 \
        --bind "ctrl-d:execute-silent(touch '$xdir/cd')+accept" \
        --preview 'rga --context 3 --no-heading {q} "$SP/"{1} 2>/dev/null | head -20' \
        --preview-window='hidden,right:50%' \
        --bind 'ctrl-p:toggle-preview' \
        --header='Enter: open at page | Ctrl-d: cd')
    [[ -z "$result" ]] && exit 0
    relpath="${result%%$'\t'*}"
    page=$(grep -oP 'Page \K[0-9]+' <<< "$result" | head -1)
    abs="$sp/$relpath"
    if [[ -e "$xdir/cd" ]]; then
        reply cd "$(dirname "$abs")"
    else
        reply none
        open_book "$abs" "$page"
    fi
    ;;

  fdata)
    result=$(fd --type f \
        -e csv -e tsv -e jsonl -e ndjson \
        -e json -e yaml -e yml \
        -e parquet -e avro -e orc -e feather \
        -e xlsx -e xls \
        -e pkl -e pickle -e joblib \
        -e h5 -e hdf5 \
        -e pt -e pth -e onnx \
        --exclude __pycache__ --exclude .git --exclude node_modules \
        --exclude .venv --exclude venv \
        2>/dev/null \
        | fzf \
            --bind "ctrl-d:execute-silent(touch '$xdir/cd')+accept" \
            --bind "ctrl-v:execute-silent(touch '$xdir/cp')+accept" \
            --preview 'bat --color=always --style=plain --line-range=:12 {} 2>/dev/null' \
            --preview-window=hidden,right:40% \
            --bind 'ctrl-p:toggle-preview' \
            --header='Enter: goto | Ctrl-d: cd | Ctrl-v: copy path')
    [[ -z "$result" ]] && exit 0
    abs=$(realpath "$result" 2>/dev/null || printf '%s' "$result")
    if [[ -e "$xdir/cd" ]]; then
        reply cd "$(dirname "$abs")"
    elif [[ -e "$xdir/cp" ]]; then
        reply none
        printf '%s' "$abs" | wl-copy
    else
        reply goto "$abs"
    fi
    ;;

  fnb)
    result=$(fd --type f --extension ipynb 2>/dev/null \
        | fzf \
            --bind "ctrl-d:execute-silent(touch '$xdir/cd')+accept" \
            --preview 'echo "Cells: $(jq ".cells | length" {} 2>/dev/null || echo unknown)"' \
            --preview-window=hidden,right:30% \
            --bind 'ctrl-p:toggle-preview' \
            --header='Enter: goto | Ctrl-d: cd')
    [[ -z "$result" ]] && exit 0
    abs=$(realpath "$result" 2>/dev/null || printf '%s' "$result")
    if [[ -e "$xdir/cd" ]]; then
        reply cd "$(dirname "$abs")"
    else
        reply goto "$abs"
    fi
    ;;

  *)
    echo "vifm-pick: unknown command '${cmd}'" >&2
    exit 1
    ;;
esac

rm -f "$xdir/cd" "$xdir/cp"
