#!/bin/bash
# Network notifications: WiFi via iwd D-Bus (event-based), Ethernet via ip monitor (event-based).
# Interface names are discovered dynamically at runtime.

WIFI=$(printf '')
ETH=$(printf '\U000f0200')
WARN='⚠'

wifi_iface() {
    iwctl device list 2>/dev/null | sed 's/\x1b\[[0-9;]*[mGKH]//g' | awk '/station/{print $1}' | head -1
}

eth_iface() {
    networkctl list --no-legend 2>/dev/null | awk '$3 == "ether" {print $2}' | head -1
}

# One notice per link, each replacing the last (-r), so mako shows the current state
# rather than a history. A dismissed id just gets a new notice.
#   show wifi|eth <urgency> <text>
declare -A shown
show() {
    shown[$1]=$(notify-send -p -r "${shown[$1]:-0}" -a "" -u "$2" -- "$3")
}

# The notify-send in show() passes `--` before the summary. The SSID is broadcast
# by whatever access point is nearby, so it is hostile input, and notify-send
# parses options anywhere in its argv: an AP named `--hint=string:image-path:...`
# would otherwise be read as flags rather than text. Verified both ways --
# without `--` a leading-dash summary produces "No summary specified"; with it,
# the same string arrives as literal text.
#
# Today the glyph happens to come first, so the SSID never leads the argument
# and the hole is not reachable. That is an accident of the format string, not a
# property of the code -- reorder it and the hole opens. `--` makes it structural.
wifi_monitor() {
    # wifi: "" = connected (or not yet known), pending = dropped less than 10 s ago,
    # down = reported down. Every resume drops and is back in ~2 s, and each failed
    # reconnect says "disconnected" again, so only a drop that lasts gets a notice.
    local line next_line rc left deadline wifi='' in_station=false in_device=false
    dbus-monitor --system \
        "type='signal',interface='org.freedesktop.DBus.Properties',path_namespace='/net/connman/iwd'" \
        | \
    while :; do
        rc=0
        if [[ $wifi == pending ]]; then
            left=$(( deadline - SECONDS ))
            if (( left > 0 )); then IFS= read -r -t "$left" line || rc=$?; else rc=142; fi
        else
            IFS= read -r line || rc=$?
        fi
        if (( rc > 128 )); then     # read timed out: still down after 10 s
            show wifi critical "${WARN}  WiFi disconnected"
            wifi=down
            continue
        fi
        (( rc == 0 )) || break      # dbus-monitor exited

        if [[ "$line" == *"member=PropertiesChanged"* ]]; then
            in_station=false; in_device=false
        fi
        if [[ "$line" == *'"net.connman.iwd.Station"'* ]]; then in_station=true; fi
        if [[ "$line" == *'"net.connman.iwd.Device"'* ]];  then in_device=true;  fi

        if $in_station && [[ "$line" == *'"State"'* ]]; then
            read -r next_line
            if [[ "$next_line" == *'"connected"'* ]]; then
                if [[ $wifi != pending ]]; then
                    iface=$(wifi_iface)
                    ssid=$(iwctl station "$iface" show 2>/dev/null | sed 's/\x1b\[[0-9;]*[mGKH]//g' | grep -oP 'Connected network\s+\K.*' | sed 's/[[:space:]]*$//')
                    show wifi normal "${WIFI}  Connected — ${ssid:-WiFi}"
                fi
                wifi=
            elif [[ "$next_line" == *'"disconnected"'* && -z $wifi ]]; then
                wifi=pending deadline=$(( SECONDS + 10 ))
            fi
            in_station=false
        fi

        if $in_device && [[ "$line" == *'"Powered"'* ]]; then
            read -r next_line
            if [[ "$next_line" == *"false"* ]]; then
                show wifi critical "${WARN}  WiFi turned off"
                wifi=down
            fi
            in_device=false
        fi
    done
}

eth_monitor() {
    local iface=$1 prev_eth=unknown
    ip monitor link | while IFS= read -r line; do
        [[ "$line" == *"$iface"* ]] || continue
        if [[ "$line" == *LOWER_UP* ]] && [ "$prev_eth" != up ]; then
            prev_eth=up
            show eth normal "${ETH}  Ethernet connected"
        elif [[ "$line" == *NO-CARRIER* ]] && [ "$prev_eth" != down ]; then
            prev_eth=down
            show eth critical "${ETH}  Ethernet disconnected"
        fi
    done
}

eth=$(eth_iface)
if [[ -n $eth ]]; then eth_monitor "$eth" & fi
wifi_monitor &

# There is no normal exit path: both watchers block until killed. Reaching here
# means one of them died (a background half used to die unnoticed), so exit
# non-zero: status 0 would read as a clean finish, and neither Restart=on-failure
# nor OnFailure= would fire. Same defect that hid the mic-notify breakage on
# 2026-09-18. dbus-monitor's stderr is deliberately not discarded, for the same reason.
wait -n
exit 1
