#!/bin/bash
# Network notices: wifi from iwd's D-Bus signals, ethernet from `ip monitor link`.
# Both are event-driven: the script sleeps until something changes.

WIFI=$'\uf1eb' ETH=$'\U000f0200' WARN='⚠'

# iwctl colours its output even into a pipe.
wifi_iface() {
    iwctl device list 2>/dev/null |
        awk '{ gsub(/\033\[[0-9;]*[mGKH]/, "") } /station/ { print $1; exit }'
}

wifi_ssid() {
    iwctl station "$1" show 2>/dev/null |
        awk '{ gsub(/\033\[[0-9;]*[mGKH]/, "") }
             sub(/^ *Connected network +/, "") { sub(/ +$/, ""); print; exit }'
}

eth_iface() {
    networkctl list --no-legend 2>/dev/null | awk '$3 == "ether" { print $2; exit }'
}

# One notice per link, each replacing the last (-r), so mako shows the current state
# rather than a history. A dismissed id just gets a new notice. `--` because the
# SSID is broadcast by any nearby access point: notify-send would parse "--hint=..."
# anywhere in its argv as an option.   show wifi|eth <urgency> <text>
declare -A shown
show() {
    shown[$1]=$(notify-send -p -r "${shown[$1]:-0}" -a "" -u "$2" -- "$3")
}

wifi_monitor() {
    # wifi: "" = connected (or not yet known), pending = dropped less than 10 s ago,
    # down = reported down. Every resume drops and is back in ~2 s, and each failed
    # reconnect says "disconnected" again, so only a drop that lasts gets a notice.
    local line next_line rc left deadline ssid wifi='' in_station=false in_device=false
    dbus-monitor --system \
        "type='signal',interface='org.freedesktop.DBus.Properties',path_namespace='/net/connman/iwd'" \
        | \
    while :; do
        rc=0
        if [[ $wifi == pending ]]; then
            left=$(( deadline - SECONDS ))
            if (( left > 0 )); then IFS= read -r -t "$left" line || rc=$?; else rc=142; fi
        else
            IFS= read -r line || rc=$?
        fi
        if (( rc > 128 )); then     # read timed out: still down after 10 s
            show wifi critical "${WARN}  WiFi disconnected"
            wifi=down
            continue
        fi
        (( rc == 0 )) || break      # dbus-monitor exited

        if [[ "$line" == *"member=PropertiesChanged"* ]]; then
            in_station=false; in_device=false
        fi
        if [[ "$line" == *'"net.connman.iwd.Station"'* ]]; then in_station=true; fi
        if [[ "$line" == *'"net.connman.iwd.Device"'* ]];  then in_device=true;  fi

        if $in_station && [[ "$line" == *'"State"'* ]]; then
            read -r next_line
            if [[ "$next_line" == *'"connected"'* ]]; then
                if [[ $wifi != pending ]]; then
                    ssid=$(wifi_ssid "$(wifi_iface)")
                    show wifi normal "${WIFI}  Connected — ${ssid:-WiFi}"
                fi
                wifi=
            elif [[ "$next_line" == *'"disconnected"'* && -z $wifi ]]; then
                wifi=pending deadline=$(( SECONDS + 10 ))
            fi
            in_station=false
        fi

        if $in_device && [[ "$line" == *'"Powered"'* ]]; then
            read -r next_line
            if [[ "$next_line" == *"false"* ]]; then
                show wifi critical "${WARN}  WiFi turned off"
                wifi=down
            fi
            in_device=false
        fi
    done
}

eth_monitor() {
    local iface=$1 prev_eth=unknown
    ip monitor link | while IFS= read -r line; do
        [[ "$line" == *"$iface"* ]] || continue
        if [[ "$line" == *LOWER_UP* ]] && [ "$prev_eth" != up ]; then
            prev_eth=up
            show eth normal "${ETH}  Ethernet connected"
        elif [[ "$line" == *NO-CARRIER* ]] && [ "$prev_eth" != down ]; then
            prev_eth=down
            show eth critical "${ETH}  Ethernet disconnected"
        fi
    done
}

eth=$(eth_iface)
if [[ -n $eth ]]; then eth_monitor "$eth" & fi
wifi_monitor &

# Both watchers run until killed, so either one ending is a failure: exit 1 lets
# Restart= and OnFailure= fire (see docs/architecture/systemd-services.md).
wait -n
exit 1
