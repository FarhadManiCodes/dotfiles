#!/usr/bin/env bash
# papis-bib: keep a LaTeX/Typst project's .bib in sync with papis.
#
#   papis-bib [<src>|<dir>] [<bib>]           auto-sync   (additive, default)
#   papis-bib --prune [<src>|<dir>] [<bib>]   cleanup     (interactive)
#
# AUTO-SYNC -- safe for the compile hook: non-interactive and NEVER destructive.
#   Adds entries newly cited in the sources (resolved from the papis library)
#   that are missing from the .bib, and keeps every existing entry exactly as
#   it is. Hand edits and no-longer-cited entries both survive; the .bib only
#   ever grows. Uncited entries don't render in a normal bibliography, so
#   keeping them is harmless -- removing them is the job of --prune. On a key
#   clash the entry already in the .bib WINS (your version is never clobbered).
#
# PRUNE -- manual only, interactive (needs a TTY). Two batch-confirmed phases:
#   1. Remove uncited : lists entries no source cites, asks once, removes them.
#   2. Update differing: lists cited entries whose .bib version differs from the
#      papis library, asks once, refreshes them from the library.
#   This is the ONLY path that deletes or overwrites existing entries.
#
# Bib filename: \addbibresource/\bibliography{} (.tex), or the first quoted
# *.bib string (.typ -- covers #bibliography(), #load-bibliography(), arrays).
# Per-project opt-out: a "papis-bib: ignore" comment (% for .tex, // for .typ)
# anywhere in a source file skips the project entirely.
#
# The papis library is never modified: only `update --from` is used (library as
# source). `update --to` (which would write to the library) is never called.

set -uo pipefail

prune=0
if [[ "${1:-}" == "--prune" ]]; then prune=1; shift; fi

arg="${1:-.}"
if [[ -f "$arg" ]]; then dir=$(cd "$(dirname "$arg")" && pwd); else dir=$(cd "$arg" 2>/dev/null && pwd) || exit 0; fi

# --- .bib filename (a name, not bib content) --------------------------------
bibname=$(grep -rhoP '\\(addbibresource|bibliography)\{\K[^}]+' "$dir"/*.tex 2>/dev/null | head -1)
# Typst: match any quoted "*.bib" -- keys off the extension, so it works
# regardless of the call (#bibliography, alexandria's #load-bibliography, ...).
[[ -z "$bibname" ]] && bibname=$(grep -rhoP '"\K[^"]+\.bib(?=")' "$dir"/*.typ 2>/dev/null | head -1)
[[ -n "$bibname" && "$bibname" != *.bib ]] && bibname="${bibname}.bib"
bib="${2:-$dir/${bibname:-refs.bib}}"

# --- per-project opt-out ----------------------------------------------------
if grep -qiE '^\s*(%+|//)\s*papis-bib:\s*ignore\b' "$dir"/*.tex "$dir"/*.typ 2>/dev/null; then
    echo "papis-bib: ignore flag found, skipping $dir"
    exit 0
fi

# --- source files (multi-file \input / #include projects) -------------------
src_args=()
for f in "$dir"/*.tex "$dir"/*.typ; do [[ -e "$f" ]] && src_args+=(-f "$f"); done
[[ ${#src_args[@]} -eq 0 ]] && exit 0

# citation keys of a papis-serialised .bib, one per line, sorted+unique.
keys_of() { grep -oP '^@\w+\{\s*\K[^,]+' "$1" 2>/dev/null | sort -u; }

# indent a newline-separated list as "  - item" bullets.
bullets() { while IFS= read -r l; do [[ -n "$l" ]] && printf '  - %s\n' "$l"; done; }

# "N entry" / "N entries" — count-aware noun (count is the number of lines in $1).
n_entries() {
    local n; n=$(grep -c . <<<"$1")
    (( n == 1 )) && printf '%s entry' "$n" || printf '%s entries' "$n"
}

# print the entry block for one key (papis puts the closing brace on its own line).
entry_block() {
    awk -v k="$2" '
        $0 ~ "^@[a-zA-Z]+\\{[[:space:]]*" k "," { p = 1 }
        p { print }
        p && /^\}/ { p = 0 }
    ' "$1"
}

# =============================================================================
# AUTO-SYNC (default)
# =============================================================================
auto_sync() {
    local cited out
    cited=$(mktemp); out=$(mktemp)

    # 1. library entries whose key is cited somewhere in the sources.
    if ! papis bibtex add --all filter-cited "${src_args[@]}" unique save -f "$cited" >/dev/null 2>&1; then
        rm -f "$cited" "$out"; echo "papis-bib: papis error, nothing changed"; return 0
    fi

    # 2. union = existing (read first, so it WINS on a key clash) + cited-from-library.
    local read_existing=()
    [[ -f "$bib" ]] && read_existing=(read "$bib")
    if ! papis bibtex "${read_existing[@]}" read "$cited" unique save -f "$out" >/dev/null 2>&1 || [[ ! -s "$out" ]]; then
        rm -f "$cited" "$out"; echo "papis-bib: nothing to sync"; return 0
    fi
    rm -f "$cited"

    if [[ -f "$bib" ]] && cmp -s "$out" "$bib"; then
        rm -f "$out"; echo "papis-bib: $(basename "$bib") already up to date"; return 0
    fi

    # Backstop: an additive union can never legitimately shrink. Fewer entries
    # than before means papis choked -- refuse rather than write a truncated .bib.
    local old=0 new
    [[ -f "$bib" ]] && old=$(grep -c '^@' "$bib")
    new=$(grep -c '^@' "$out")
    if (( new < old )); then
        rm -f "$out"
        echo "papis-bib: REFUSING -- additive sync produced fewer entries ($old -> $new); papis likely errored."
        command -v notify-send >/dev/null && notify-send -u critical "papis-bib: refused" "$(basename "$bib"): $old -> $new entries"
        return 1
    fi

    mv "$out" "$bib"
    echo "papis-bib: synced $(basename "$bib") ($old -> $new entries)"
    command -v notify-send >/dev/null && notify-send -u low "papis-bib" "Synced $(basename "$bib") ($old -> $new entries)"
}

# =============================================================================
# PRUNE (interactive)
# =============================================================================
prune_mode() {
    if [[ ! -t 0 ]]; then
        echo "papis-bib --prune: needs an interactive terminal; aborting."; return 1
    fi
    if [[ ! -f "$bib" ]]; then
        echo "papis-bib --prune: $bib does not exist, nothing to prune."; return 0
    fi

    # Normalise through papis up front so later diffs reflect content, not the
    # difference between hand formatting and papis' serialisation.
    local work; work=$(mktemp)
    papis bibtex read "$bib" save -f "$work" >/dev/null 2>&1
    local changed=0

    # ---- Phase 1: remove uncited -------------------------------------------
    local pruned removed
    pruned=$(mktemp)
    papis bibtex read "$work" filter-cited "${src_args[@]}" unique save -f "$pruned" >/dev/null 2>&1
    removed=$(comm -23 <(keys_of "$work") <(keys_of "$pruned"))
    if [[ -n "$removed" ]]; then
        echo "Uncited entries in $(basename "$bib") (no source cites them):"
        bullets <<<"$removed"
        read -rp "Remove $(n_entries "$removed") (uncited)? [y/N] " ans
        if [[ "$ans" == [yY] ]]; then
            mv "$pruned" "$work"; changed=1; echo "  removed."
        else
            rm -f "$pruned"; echo "  kept."
        fi
    else
        rm -f "$pruned"; echo "papis-bib --prune: no uncited entries."
    fi

    # ---- Phase 2: update entries that differ from the library --------------
    local updated; updated=$(mktemp)
    papis bibtex read "$work" update --from --all save -f "$updated" >/dev/null 2>&1
    if ! cmp -s "$work" "$updated"; then
        local diffkeys=""
        while read -r k; do
            [[ -z "$k" ]] && continue
            if ! diff -q <(entry_block "$work" "$k") <(entry_block "$updated" "$k") >/dev/null 2>&1; then
                diffkeys+="$k"$'\n'
            fi
        done < <(comm -12 <(keys_of "$work") <(keys_of "$updated"))
        diffkeys=${diffkeys%$'\n'}

        if [[ -n "$diffkeys" ]]; then
            echo "Cited entries whose $(basename "$bib") version differs from papis:"
            bullets <<<"$diffkeys"
            read -rp "Update $(n_entries "$diffkeys") from the library? [y/N] " ans
            if [[ "$ans" == [yY] ]]; then
                mv "$updated" "$work"; changed=1; echo "  updated."
            else
                rm -f "$updated"; echo "  kept."
            fi
        else
            rm -f "$updated"
        fi
    else
        rm -f "$updated"; echo "papis-bib --prune: no entries differ from the library."
    fi

    # ---- Write back only if the user confirmed a change --------------------
    if (( changed )); then
        mv "$work" "$bib"
        echo "papis-bib --prune: wrote $(basename "$bib") ($(grep -c '^@' "$bib") entries)."
    else
        rm -f "$work"; echo "papis-bib --prune: no changes made."
    fi
}

if (( prune )); then prune_mode; else auto_sync; fi
