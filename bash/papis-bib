#!/usr/bin/env bash
# papis-bib: keep a LaTeX/Typst project's .bib in sync with papis.
#
#   papis-bib [<src>|<dir>] [<bib>]           auto-sync   (additive, default)
#   papis-bib --prune [<src>|<dir>] [<bib>]   cleanup     (interactive)
#
# AUTO-SYNC -- safe for the compile hook: non-interactive and NEVER destructive.
#   Adds entries newly cited in the sources (resolved from the papis library)
#   that are missing from the .bib, and keeps every existing entry exactly as
#   it is. Hand edits and no-longer-cited entries both survive; the .bib only
#   ever grows. Uncited entries don't render in a normal bibliography, so
#   keeping them is harmless -- removing them is the job of --prune. On a key
#   clash the entry already in the .bib WINS (your version is never clobbered).
#
# PRUNE -- manual only, interactive (needs a TTY). Two batch-confirmed phases:
#   1. Remove uncited : lists entries no source cites, asks once, removes them.
#   2. Update differing: lists cited entries whose .bib version differs from the
#      papis library, asks once, refreshes them from the library.
#   This is the ONLY path that deletes or overwrites existing entries.
#
# Bib filename: \addbibresource/\bibliography{} (.tex), or the first quoted
# *.bib string (.typ -- covers #bibliography(), #load-bibliography(), arrays).
# Per-project opt-out: a "papis-bib: ignore" comment (% for .tex, // for .typ)
# anywhere in a source file skips the project entirely.
#
# The papis library is never modified: only `update --from` is used (library as
# source). `update --to` (which would write to the library) is never called.

set -uo pipefail

# Track every temp file and remove them on any exit (incl. Ctrl-C at a prompt),
# so an interrupted run never leaves scratch files behind. INT/TERM must exit:
# a trap that only cleans up leaves `read` waiting at the same prompt, with the
# working files gone.
TMPS=()
cleanup() { ((${#TMPS[@]})) && rm -f "${TMPS[@]}" 2>/dev/null; }
trap cleanup EXIT
trap 'exit 130' INT TERM
# mktmp VAR [mktemp args]: sets VAR rather than printing the name, because
# $(mktmp) would run in a subshell and its TMPS entry would be lost.
mktmp() {
  local -n _tmp=$1
  shift
  _tmp=$(mktemp "$@") || fail "cannot create a temporary file"
  TMPS+=("$_tmp")
}

# Atomically replace $bib with the contents of $1. The staging temp is created
# in $bib's own directory so the final `mv` is a same-filesystem rename (atomic)
# rather than a cross-fs copy from /tmp -- the .bib is never left half-written.
commit_bib() {
  local real staged
  real=$(readlink -f -- "$bib") || return 1 # a symlinked .bib is written where it points
  # A read-only .bib was protected on purpose: leave it, say so quietly, and succeed.
  if [[ -e $real && ! -w $real ]]; then
    echo "papis-bib: ${bib##*/} is read-only, left unchanged"
    command -v notify-send >/dev/null && notify-send -u low "papis-bib" "${bib##*/} is read-only, left unchanged"
    exit 0
  fi
  staged=$(mktemp -p "$(dirname "$real")" ".${real##*/}.XXXXXX") || return 1
  TMPS+=("$staged")
  # mktemp makes 0600; keep the .bib's own mode
  [[ ! -e $real ]] || chmod --reference="$real" -- "$staged" || return 1
  cp -- "$1" "$staged" && mv -- "$staged" "$real"
}

# The compile hook discards this script's output (nvim runs it through
# vim.fn.system), so a failure also notifies: otherwise it is never seen.
fail() {
  echo "papis-bib: $1"
  command -v notify-send >/dev/null && notify-send -u critical "papis-bib" "$1"
  exit 1
}

# papis bibtex ..., ending the run with papis's last error line if it fails.
# papis exits 0 for no citations, an empty .bib and unknown keys, so a non-zero
# status is a real error (a missing or unreadable file).
bibtex() {
  local err
  err=$(papis bibtex "$@" 2>&1 >/dev/null) || fail "papis failed: ${err##*$'\n'}"
}

prune=0
if [[ "${1:-}" == "--prune" ]]; then
  prune=1
  shift
fi

arg="${1:-.}"
if [[ -f "$arg" ]]; then dir=$(cd "$(dirname "$arg")" && pwd); else dir=$(cd "$arg" 2>/dev/null && pwd) || exit 0; fi

# --- .bib filename (a name, not bib content) --------------------------------
bibname=$(grep -rhoP '\\(addbibresource|bibliography)\{\K[^}]+' "$dir"/*.tex 2>/dev/null | head -1)
# Typst: match any quoted "*.bib" -- keys off the extension, so it works
# regardless of the call (#bibliography, alexandria's #load-bibliography, ...).
[[ -z "$bibname" ]] && bibname=$(grep -rhoP '"\K[^"]+\.bib(?=")' "$dir"/*.typ 2>/dev/null | head -1)
[[ -n "$bibname" && "$bibname" != *.bib ]] && bibname="${bibname}.bib"
bib="${2:-$dir/${bibname:-refs.bib}}"

# --- per-project opt-out ----------------------------------------------------
if grep -qiE '^\s*(%+|//)\s*papis-bib:\s*ignore\b' "$dir"/*.tex "$dir"/*.typ 2>/dev/null; then
  echo "papis-bib: ignore flag found, skipping $dir"
  exit 0
fi

# --- source files (multi-file \input / #include projects) -------------------
src_args=()
for f in "$dir"/*.tex "$dir"/*.typ; do [[ -e "$f" ]] && src_args+=(-f "$f"); done
[[ ${#src_args[@]} -gt 0 ]] || exit 0

# citation keys of a papis-serialised .bib, one per line, sorted+unique. Fails
# only when the file cannot be read; a file without keys is an empty list.
keys_of() { { grep -oP '^@\w+\{\s*\K[^,]+' "$1" || (($? == 1)); } | sort -u; }

# read_keys VAR FILE: VAR = the keys of FILE; stops the run if FILE cannot be read.
read_keys() {
  local -n _keys=$1
  _keys=$(keys_of "$2") || fail "cannot read papis's output for ${bib##*/}"
}

# indent a newline-separated list as "  - item" bullets.
bullets() { while IFS= read -r l; do [[ -n "$l" ]] && printf '  - %s\n' "$l"; done; }

# n_entries VAR LIST: VAR = "N entry" / "N entries", N = the non-empty lines of LIST.
n_entries() {
  local -n _noun=$1
  local line n=0
  while IFS= read -r line; do [[ -n $line ]] && ((++n)); done <<<"$2"
  ((n == 1)) && _noun='1 entry' || _noun="$n entries"
}

# print the entry block for one key (papis puts the closing brace on its own line).
# The key is compared as text, not used as a regex: "a.b" must not match "axb".
entry_block() {
  awk -v k="$2" '
        /^@[a-zA-Z]+\{/ { key = $0; sub(/^@[a-zA-Z]+\{[[:space:]]*/, "", key); sub(/,.*/, "", key); p = key == k }
        p { print }
        p && /^\}/ { p = 0 }
    ' "$1"
}

# =============================================================================
# AUTO-SYNC (default)
# =============================================================================
auto_sync() {
  local cited out
  mktmp cited
  mktmp out

  # 1. library entries whose key is cited somewhere in the sources.
  bibtex add --all filter-cited "${src_args[@]}" unique save -f "$cited"

  # 2. union = existing (read first, so it WINS on a key clash) + cited-from-library.
  local read_existing=()
  [[ -f "$bib" ]] && read_existing=(read "$bib")
  bibtex "${read_existing[@]}" read "$cited" unique save -f "$out"
  if [[ ! -s "$out" ]]; then
    echo "papis-bib: nothing to sync"
    return 0
  fi

  if [[ -f "$bib" ]] && cmp -s "$out" "$bib"; then
    rm -f "$out"
    echo "papis-bib: ${bib##*/} already up to date"
    return 0
  fi

  # Backstop: an additive union can never legitimately shrink. Fewer entries
  # than before means papis choked -- refuse rather than write a truncated .bib.
  local old=0 new
  [[ -f "$bib" ]] && old=$(grep -c '^@' "$bib")
  new=$(grep -c '^@' "$out")
  if ((new < old)); then
    rm -f "$out"
    echo "papis-bib: REFUSING -- additive sync produced fewer entries ($old -> $new); papis likely errored."
    command -v notify-send >/dev/null && notify-send -u critical "papis-bib: refused" "${bib##*/}: $old -> $new entries"
    return 1
  fi

  commit_bib "$out" || fail "failed to write $bib"
  echo "papis-bib: synced ${bib##*/} ($old -> $new entries)"
  command -v notify-send >/dev/null && notify-send -u low "papis-bib" "Synced ${bib##*/} ($old -> $new entries)"
}

# =============================================================================
# PRUNE (interactive)
# =============================================================================
prune_mode() {
  if [[ ! -t 0 ]]; then
    echo "papis-bib --prune: needs an interactive terminal; aborting."
    return 1
  fi
  if [[ ! -f "$bib" ]]; then
    echo "papis-bib --prune: $bib does not exist, nothing to prune."
    return 0
  fi

  # Normalise through papis up front so later diffs reflect content, not the
  # difference between hand formatting and papis' serialisation.
  local work
  mktmp work
  # Every papis step goes through bibtex(): a failed filter-cited left an empty
  # list, which read as "no source cites anything" and offered every entry.
  bibtex read "$bib" save -f "$work"
  local changed=0 ans count

  # ---- Phase 1: remove uncited -------------------------------------------
  local pruned removed
  mktmp pruned
  bibtex read "$work" filter-cited "${src_args[@]}" unique save -f "$pruned"
  local work_keys pruned_keys
  read_keys work_keys "$work"
  read_keys pruned_keys "$pruned"
  removed=$(comm -23 <(printf '%s\n' "$work_keys") - <<<"$pruned_keys")
  if [[ -n "$removed" ]]; then
    echo "Uncited entries in ${bib##*/} (no source cites them):"
    bullets <<<"$removed"
    n_entries count "$removed"
    read -rp "Remove $count (uncited)? [y/N] " ans
    if [[ "$ans" == [yY] ]]; then
      mv "$pruned" "$work"
      changed=1
      echo "  removed."
    else
      rm -f "$pruned"
      echo "  kept."
    fi
  else
    rm -f "$pruned"
    echo "papis-bib --prune: no uncited entries."
  fi

  # ---- Phase 2: update entries that differ from the library --------------
  local updated
  mktmp updated
  bibtex read "$work" update --from --all save -f "$updated"
  if ! cmp -s "$work" "$updated"; then
    local diffkeys="" updated_keys common old new
    read_keys work_keys "$work"
    read_keys updated_keys "$updated"
    common=$(comm -12 <(printf '%s\n' "$work_keys") - <<<"$updated_keys")
    while read -r k; do
      [[ -z "$k" ]] && continue
      old=$(entry_block "$work" "$k") || fail "cannot read $k from $work"
      new=$(entry_block "$updated" "$k") || fail "cannot read $k from $updated"
      [[ $old == "$new" ]] || diffkeys+="$k"$'\n'
    done <<<"$common"
    diffkeys=${diffkeys%$'\n'}

    if [[ -n "$diffkeys" ]]; then
      echo "Cited entries whose ${bib##*/} version differs from papis:"
      bullets <<<"$diffkeys"
      n_entries count "$diffkeys"
      read -rp "Update $count from the library? [y/N] " ans
      if [[ "$ans" == [yY] ]]; then
        mv "$updated" "$work"
        changed=1
        echo "  updated."
      else
        rm -f "$updated"
        echo "  kept."
      fi
    else
      rm -f "$updated"
    fi
  else
    rm -f "$updated"
    echo "papis-bib --prune: no entries differ from the library."
  fi

  # ---- Write back only if the user confirmed a change --------------------
  if ((changed)); then
    if commit_bib "$work"; then
      local total
      total=$(grep -c '^@' "$bib") # prints 0 (and exits 1) when no entry is left
      echo "papis-bib --prune: wrote ${bib##*/} ($total entries)."
    else
      echo "papis-bib --prune: failed to write $bib"
      return 1
    fi
  else
    echo "papis-bib --prune: no changes made."
  fi
}

if ((prune)); then prune_mode; else auto_sync; fi
