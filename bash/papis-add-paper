#!/usr/bin/env bash
# Add a paper to papis from a browser page — called by Tridactyl ,p binding
# Usage: papis-add-paper <importer> [identifier]   (identifier from stdin if omitted)
# Importers: doi (journal pages), arxiv (arXiv pages — also downloads PDF)
# Tridactyl passes the identifier on stdin, as native.run's content: the command
# goes through /bin/sh, and a DOI taken from a page's citation_doi meta tag is
# whatever the page says, so inside the command line it could run commands.
#
# Launched from Firefox (no terminal), so it confirms in a small floating
# footclient window showing the title + DOI/arXiv id. You edit a pre-filled
# reference key (readline) and optionally type tags. Empty key cancels.
# The key is kept UNIQUE — papis allows duplicate refs but papis.nvim's sqlite
# cache enforces UNIQUE(ref), so a clash there would break the nvim side; we
# auto-disambiguate the suggestion and re-prompt on a typed clash.

set -uo pipefail

importer="${1:-}"
if (($# >= 2)); then identifier=$2; else identifier=$(cat); fi

[[ -z "$importer" || -z "$identifier" ]] && {
    notify-send -u critical "Papis" "Usage: papis-add-paper <importer> [identifier]"
    exit 1
}

# --- fetch metadata (best-effort) for the title + a suggested ref key --------
# Prints "title SEP family SEP year"; SEP is the unit separator, not a tab, since
# `read` would merge a run of tabs when a field is empty.
export SEP=$'\x1f'
fetch_meta() {
    case "$1" in
        doi)
            curl -sSL -m 8 "https://api.crossref.org/works/$2" 2>/dev/null | jq -r --arg s "$SEP" '
                .message | [(.title[0] // ""), (.author[0].family // ""),
                            (.issued."date-parts"[0][0] // "" | tostring)] | join($s)' ;;
        arxiv)
            # Atom XML parsed with yq (-p=xml), not grep/sed on markup. arXiv wraps
            # long titles over several lines, hence the whitespace squeeze.
            # shellcheck disable=SC2016  # ${1} is yq's capture group, not shell
            curl -sSL -m 8 "https://export.arxiv.org/api/query?id_list=$2" 2>/dev/null | yq -p=xml '
                [(.feed.entry.title // "" | sub("\s+"; " ")),
                 ((.feed.entry.author[0].name // .feed.entry.author.name // "") | sub(".* "; "")),
                 ((.feed.entry.published // "") | sub("^(....).*"; "${1}"))] | join(strenv(SEP))' ;;
    esac
}

# papis-style citation key: alphanumerics joined by single underscores.
sanitize_ref() { printf '%s' "$1" | sed 's/[^[:alnum:]]\+/_/g; s/^_*//; s/_*$//'; }

# Snapshot keys, identifiers and tags once, read straight from YAML with yq:
# accurate (handles any field content) and faster than papis' Python startup.
PAPERS="$HOME/.local/share/papis/papers"
# yq stops at the first unreadable info.yaml, and every key after it would look
# free: a duplicate ref breaks papis.nvim, so a failed scan stops here.
# "ref \t doi \t eprint \t tags" per entry.
library=$(yq -o=tsv '[.ref, (.doi // ""), (.eprint // ""), ((.tags // []) | join(" "))]' \
    "$PAPERS"/*/info.yaml 2>&1) \
    || { notify-send -u critical "Papis" "Library scan failed: ${library##*$'\n'}"; exit 1; }
existing_refs=$(cut -f1 <<<"$library")
ref_taken() { grep -qxF -- "$1" <<<"$existing_refs"; }

# Already in the library? A DOI matches case-insensitively, an arXiv id without
# its version suffix (entries store "2602.23859v2" as well as "2606.14130").
existing=$(ID=$identifier IMP=$importer awk -F'\t' '
    function bare(s) { s = tolower(s); if (ENVIRON["IMP"] == "arxiv") sub(/v[0-9]+$/, "", s); return s }
    BEGIN { id = bare(ENVIRON["ID"]); col = (ENVIRON["IMP"] == "doi") ? 2 : 3 }
    $col != "" && bare($col) == id { print $1; exit }' <<<"$library")
[[ -n "$existing" ]] && { notify-send -u low "Papis" "Already in papis as $existing\n$identifier"; exit 0; }
existing_tags=$(cut -f4 <<<"$library" | tr ' ' '\n' | sort -u | grep . | paste -sd' ' -)

# Append a/b/c… (then _2, _3…) until the key is free.
free_ref() {
    local base="$1" cand="$1" i
    ref_taken "$cand" || { printf '%s' "$cand"; return; }
    for i in {a..z}; do cand="${base}${i}"; ref_taken "$cand" || { printf '%s' "$cand"; return; }; done
    i=2; while ref_taken "${base}_${i}"; do i=$((i+1)); done; printf '%s' "${base}_${i}"
}

# Prompt for the reference key + tags in a small floating footclient window.
# Sets globals OUT_KEY (sanitised) and OUT_TAGS. Args: <mesg> <key-prefill> <tags-prefill>
OUT_KEY=""; OUT_TAGS=""
prompt_meta() {
    local out; out=$(mktemp)
    # $1..$4 below are positional args for the INNER bash -c, so single quotes
    # are intentional (they must not expand in this outer shell).
    # shellcheck disable=SC2016
    footclient --app-id=papis-ref-edit --title="papis: add reference" \
        bash -c '
            printf "%s\n\nEdit the key, Enter to confirm each field; empty key cancels.\n\n" "$1"
            read -e -r -i "$2" -p "reference key> " k || k=""
            read -e -r -i "$3" -p "tags (space-separated, optional)> " t || t=""
            printf "%s\n%s" "$k" "$t" > "$4"
        ' _ "$1" "$2" "$3" "$out" 2>/dev/null
    # footclient exits 220 (itself) or 230 (the server) when no window opened;
    # otherwise with the prompt's own status, and Ctrl-C/closing is a cancel.
    case $? in
        220|230) rm -f "$out"; notify-send -u critical "Papis" "Could not open the prompt window (foot server not running?)"; exit 1 ;;
    esac
    OUT_KEY=$(sanitize_ref "$(sed -n 1p "$out" 2>/dev/null)")
    OUT_TAGS=$(sed -n 2p "$out" 2>/dev/null | tr -s ' ' | sed 's/^ *//; s/ *$//')
    rm -f "$out"
}

IFS=$SEP read -r META_TITLE META_FAMILY META_YEAR < <(fetch_meta "$importer" "$identifier" 2>/dev/null)

base=$(sanitize_ref "$META_FAMILY")
[[ -n "$META_YEAR" ]] && base="${base:+${base}_}$META_YEAR"
[[ -z "$base" ]] && base=$(sanitize_ref "$identifier")
suggest=$(free_ref "$base")          # first free variant of the suggestion

mesg="Add to papis:
  ${META_TITLE:-$identifier}
  $importer: $identifier"
[[ -n "$existing_tags" ]] && mesg="$mesg
  existing tags: $existing_tags"

# Prompt, and keep prompting until the chosen key is non-empty and free.
prompt_meta "$mesg" "$suggest" ""
while [[ -n "$OUT_KEY" ]] && ref_taken "$OUT_KEY"; do
    prompt_meta "Key '$OUT_KEY' already exists — choose another.

$mesg" "$OUT_KEY" "$OUT_TAGS"
done
[[ -z "$OUT_KEY" ]] && { notify-send -u low "Papis" "Cancelled"; exit 0; }
ref="$OUT_KEY"; tags="$OUT_TAGS"

notify-send -u low "Papis" "Adding as $ref…\n$identifier"

# --batch is required: --set turns the value into a second metadata source, and
# without it papis prompts to merge importer-vs-command-line (no TTY -> "Aborted!").
if ! output=$(papis add --from "$importer" "$identifier" --no-edit --batch --set ref "$ref" 2>&1); then
    notify-send -u critical "Papis" "Failed to add\n$identifier\n$(tail -1 <<<"$output")"
    exit 1
fi
# --batch refuses a duplicate found on another unique key (isbn, url, ...) but
# still exits 0, after logging the folder it would have used.
if [[ $output == *'No new document is created'* ]]; then
    notify-send -u normal "Papis" "Already in papis (matched on another field), not added\n$identifier"
    exit 0
fi

# The new entry, found by its key rather than by papis's "Document folder is"
# info log line, which depends on papis's log level.
info=$(REF=$ref yq 'select(.ref == strenv(REF)) | filename' "$PAPERS"/*/info.yaml 2>/dev/null | head -1)
[[ -f "$info" ]] || { notify-send -u critical "Papis" "Added as $ref, but its folder was not found: tags not set"; exit 1; }

# Store tags as a proper YAML list (papis.nvim requires list type, one element per
# tag). papis --set only writes a string, so set the split list with yq directly.
if [[ -n "$tags" ]] && ! tags="$tags" yq -i '.tags = (strenv(tags) | split(" "))' "$info"; then
    notify-send -u critical "Papis" "Added as $ref, but writing the tags failed"; exit 1
fi

tagnote=""; [[ -n "$tags" ]] && tagnote="\\n[$tags]"
nfiles=$(yq '(.files // []) | length' "$info" 2>/dev/null)
if [[ "${nfiles:-0}" -gt 0 ]]; then
    notify-send -u low "Papis" "Added with PDF ✓\n$ref$tagnote"
else
    notify-send -u normal "Papis" "Added — PDF not downloaded\n$ref$tagnote"
fi
