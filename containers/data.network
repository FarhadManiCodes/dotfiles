# Quadlet network — containers on it resolve each other by name (netavark +
# aardvark-dns). The default rootless network has no DNS between containers,
# so anything that needs to reach `pg` by hostname must join this one.
[Network]
NetworkName=data

# No [Install] target: pg.service starts this network through its generated
# Requires=/After= dependency when PostgreSQL is requested.

# Drops Quadlet's implicit wait on network-online.target, which this machine never
# reaches (systemd-networkd-wait-online is masked for boot speed). Without this the
# injected podman-user-wait-network-online.service polls for 90s, fails, and delays
# start by that much. Belongs in [Quadlet]; [Unit] has the same key, different meaning.
[Quadlet]
DefaultDependencies=false
